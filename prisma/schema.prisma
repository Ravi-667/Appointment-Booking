generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String   @db.VarChar(100)
  slug                    String   @unique @db.VarChar(50)
  category                String?  @db.VarChar(50)
  email                   String   @unique @db.VarChar(255)
  phone                   String?  @db.VarChar(20)
  address                 String?
  timezone                String   @default("Asia/Kolkata")
  currency                String   @default("INR") @db.Char(3)
  logoUrl                 String?
  plan                    String   @default("free")
  isActive                Boolean  @default(true)
  bookingLeadTimeHours    Int      @default(1)
  bookingAdvanceLimitDays Int      @default(60)
  cancellationCutoffHours Int      @default(24)
  bufferMinutes           Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users         User[]
  businessHours BusinessHour[]
  holidays      Holiday[]
  services      Service[]
  staff         Staff[]
  bookings      Booking[]
  auditLogs     AuditLog[]

  @@map("tenants")
}

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String?   @db.Uuid
  email                 String    @db.VarChar(255)
  phone                 String?   @db.VarChar(20)
  name                  String    @db.VarChar(100)
  passwordHash          String?
  googleId              String?   @unique @db.VarChar(100)
  role                  String    @db.VarChar(20)
  emailVerified         Boolean   @default(false)
  emailVerifyToken      String?
  emailVerifyTokenExp   DateTime?
  passwordResetToken    String?
  passwordResetTokenExp DateTime?
  avatarUrl             String?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([email, tenantId])
  @@map("users")
}

model BusinessHour {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @db.Uuid
  dayOfWeek   Int
  openTime    String
  closeTime   String
  isOpen      Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek])
  @@map("business_hours")
}

model Holiday {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @db.Uuid
  date     DateTime @db.Date
  reason   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@map("holidays")
}

model ServiceCategory {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String  @unique @db.VarChar(50)
  icon  String?
  color String? @db.VarChar(7)

  services Service[]

  @@map("service_categories")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  name            String   @db.VarChar(100)
  description     String?
  categoryId      String?  @db.Uuid
  durationMinutes Int
  price           Decimal  @db.Decimal(10, 2)
  depositAmount   Decimal  @default(0) @db.Decimal(10, 2)
  maxConcurrent   Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id])
  staffServices StaffService[]
  bookings      Booking[]

  @@map("services")
}

model Staff {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @db.Uuid
  name      String  @db.VarChar(100)
  bio       String?
  avatarUrl String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  schedules     StaffSchedule[]
  bookings      Booking[]
  bookingHolds  BookingHold[]

  @@map("staff")
}

model StaffService {
  staffId   String @db.Uuid
  serviceId String @db.Uuid

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

model StaffSchedule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId   String   @db.Uuid
  date      DateTime @db.Date
  isOff     Boolean  @default(false)
  startTime String?
  endTime   String?

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("staff_schedules")
}

model BookingHold {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  serviceId    String   @db.Uuid
  staffId      String?  @db.Uuid
  startTime    DateTime
  endTime      DateTime
  sessionToken String   @unique @db.VarChar(64)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id])

  @@map("booking_holds")
}

model Booking {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  serviceId          String   @db.Uuid
  staffId            String?  @db.Uuid
  customerName       String   @db.VarChar(100)
  customerEmail      String   @db.VarChar(255)
  customerPhone      String?  @db.VarChar(20)
  customerNotes      String?
  startTime          DateTime
  endTime            DateTime
  status             String   @default("PENDING_PAYMENT") @db.VarChar(30)
  price              Decimal  @db.Decimal(10, 2)
  depositAmount      Decimal  @db.Decimal(10, 2)
  razorpayOrderId    String?  @unique @db.VarChar(100)
  cancellationReason String?
  rescheduledFromId  String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  service         Service   @relation(fields: [serviceId], references: [id])
  staff           Staff?    @relation(fields: [staffId], references: [id])
  rescheduledFrom Booking?  @relation("RescheduleChain", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Booking[] @relation("RescheduleChain")
  payments        Payment[]

  @@index([tenantId, startTime])
  @@index([staffId, startTime])
  @@map("bookings")
}

model Payment {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String   @db.Uuid
  tenantId          String   @db.Uuid
  razorpayOrderId   String?  @unique @db.VarChar(100)
  razorpayPaymentId String?  @unique @db.VarChar(100)
  amount            Decimal  @db.Decimal(10, 2)
  currency          String   @default("INR") @db.Char(3)
  status            String   @default("PENDING") @db.VarChar(20)
  type              String   @default("DEPOSIT") @db.VarChar(20)
  webhookEventId    String?  @unique @db.VarChar(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@map("payments")
}

model Refund {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String   @db.Uuid
  razorpayRefundId String?  @unique @db.VarChar(100)
  amount           Decimal  @db.Decimal(10, 2)
  reason           String?
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model NotificationLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  bookingId    String?   @db.Uuid
  channel      String    @db.VarChar(20)
  recipient    String    @db.VarChar(255)
  type         String    @db.VarChar(50)
  status       String    @default("PENDING") @db.VarChar(20)
  errorMessage String?
  attempts     Int       @default(0)
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@map("notification_logs")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(50)
  entityId   String?  @db.Uuid
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("audit_logs")
}

