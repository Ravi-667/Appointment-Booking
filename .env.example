# =============================================================================
# APPOINTMENT BOOKING PLATFORM - Environment Variables (Example)
# =============================================================================
# Copy this file to .env and fill in YOUR values. NEVER commit .env to git.
#
# To obtain API keys:
#   - Razorpay:      https://dashboard.razorpay.com  (Sign up -> Keys)
#   - SendGrid:      https://sendgrid.com             (Sign up -> API Keys)
#   - Twilio:        https://www.twilio.com           (Account -> API Credentials)
#   - Sentry:        https://sentry.io                (Create account -> New Project -> DSN)
#   - Prometheus:    https://prometheus.io            (Self-hosted or cloud)
#   - Grafana:       https://grafana.com              (Cloud or self-hosted)
#   - Postgres:      https://aws.amazon.com/rds       (RDS) or run docker-compose locally
#   - Redis:         https://redis.com/cloud           or run docker-compose locally
#   - Kafka:         https://confluent.io/cloud        or run docker-compose locally
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 15)
# -----------------------------------------------------------------------------
# Local (docker-compose): postgresql://postgres:postgres@localhost:5432/booking_dev
# RDS (production):      postgresql://user:password@hostname:5432/booking_prod
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_dev
DATABASE_POOL_SIZE=25
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_MAXMEMORY=256mb

# -----------------------------------------------------------------------------
# JWT (asymmetric RS256)
# -----------------------------------------------------------------------------
# Generate once (save as JWT_PRIVATE_KEY.pem and JWT_PUBLIC_KEY.pem):
#   openssl genrsa -out JWT_PRIVATE_KEY.pem 4096
#   openssl rsa -in JWT_PRIVATE_KEY.pem -pubout -out JWT_PUBLIC_KEY.pem
# Store the PEM CONTENTS in these env vars. Do NOT commit PEM files.
# DEV (replace with your own generated keys — do not reuse in prod):
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_PEM_CONTENTS_HERE\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_PEM_CONTENTS_HERE\n-----END PUBLIC KEY-----
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=appointment-booking-platform

# -----------------------------------------------------------------------------
# Razorpay Payments (Test keys from https://dashboard.razorpay.com/app/keys)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# -----------------------------------------------------------------------------
# Email (Nodemailer)
# -----------------------------------------------------------------------------
# Local (docker-compose MailHog): SMTP_HOST=mailhog, SMTP_PORT=1025, no auth
# SendGrid production: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=sg.xxxxxx
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@bookingapp.local
EMAIL_FROM_NAME=Booking Platform

# -----------------------------------------------------------------------------
# SMS (Twilio or MSG91)
# -----------------------------------------------------------------------------
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SENDER_PHONE=+1234567890
MSG91_AUTH_KEY=your_msg91_auth_key

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=booking-api

# -----------------------------------------------------------------------------
# AWS S3 (file uploads - optional; local storage used when not set)
# -----------------------------------------------------------------------------
AWS_BUCKET_NAME=booking-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Monitoring / Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
PROMETHEUS_PORT=9464

# -----------------------------------------------------------------------------
# Business defaults
# -----------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
