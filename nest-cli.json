{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true
  },
  "monorepo": true,
  "projects": {
    "api": {
      "type": "application",
      "generateNgModules": true,
      "root": "src",
      "entryFile": "main",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "src/tsconfig.app.json"
      }
    },
    "worker": {
      "type": "application",
      "generateNgModules": true,
      "root": "src/worker",
      "entryFile": "main",
      "sourceRoot": "src/worker",
      "compilerOptions": {
        "tsConfigPath": "src/worker/tsconfig.app.json"
      }
    },
    "analytics": {
      "type": "application",
      "generateNgModules": true,
      "root": "src/analytics",
      "entryFile": "main",
      "sourceRoot": "src/analytics",
      "compilerOptions": {
        "tsConfigPath": "src/analytics/tsconfig.app.json"
      }
    }
  }
}
