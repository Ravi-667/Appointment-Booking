<!-- ═══════════════════════════════════════════════════════════
     Messages & Inquiries Hub — Owner Dashboard
════════════════════════════════════════════════════════════ -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <!-- Top header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2">
        <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        Messages & Inquiries
      </h1>
      <p class="text-sm text-gray-500 mt-0.5">Communicate with prospective visitors and booked customers in real time.</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Live Real-Time Active
      </span>
    </div>
  </div>

  <!-- Main Chat Grid Card -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[640px] h-[calc(100vh-210px)] max-h-[820px]">
    
    <!-- ── Left Sidebar: Threads List (md:col-span-5 lg:col-span-4) ── -->
    <div class="md:col-span-5 lg:col-span-4 border-r border-gray-200 flex flex-col h-full bg-gray-50/40">
      
      <!-- Tabs (Inquiries vs Bookings vs Staff Team) -->
      <div class="p-3 border-b border-gray-200 bg-white">
        <div class="flex rounded-xl bg-gray-100 p-1 text-xs font-semibold gap-1">
          <button type="button" id="tab-inquiries-btn" onclick="switchTab('INQUIRIES')"
            class="flex-1 py-2 px-1.5 rounded-lg text-center transition flex items-center justify-center gap-1 bg-white text-gray-900 shadow-xs font-semibold cursor-pointer">
            <span>Inquiries</span>
            <span id="tab-inquiries-count" class="px-1.5 py-0.2 text-[10px] rounded-full bg-gray-200 text-gray-700 font-bold">0</span>
            <span id="tab-inquiries-badge" class="hidden px-1.5 py-0.2 text-[10px] rounded-full bg-red-600 text-white font-bold animate-pulse">0</span>
          </button>
          <button type="button" id="tab-bookings-btn" onclick="switchTab('BOOKINGS')"
            class="flex-1 py-2 px-1.5 rounded-lg text-center transition flex items-center justify-center gap-1 text-gray-500 hover:text-gray-900 font-medium cursor-pointer">
            <span>Bookings</span>
            <span id="tab-bookings-count" class="px-1.5 py-0.2 text-[10px] rounded-full bg-gray-200 text-gray-700 font-bold">0</span>
            <span id="tab-bookings-badge" class="hidden px-1.5 py-0.2 text-[10px] rounded-full bg-red-600 text-white font-bold animate-pulse">0</span>
          </button>
          <button type="button" id="tab-staff-btn" onclick="switchTab('STAFF')"
            class="flex-1 py-2 px-1.5 rounded-lg text-center transition flex items-center justify-center gap-1 text-gray-500 hover:text-gray-900 font-medium cursor-pointer">
            <span>Staff Team</span>
            <span id="tab-staff-count" class="px-1.5 py-0.2 text-[10px] rounded-full bg-gray-200 text-gray-700 font-bold">0</span>
            <span id="tab-staff-badge" class="hidden px-1.5 py-0.2 text-[10px] rounded-full bg-red-600 text-white font-bold animate-pulse">0</span>
          </button>
        </div>

        <!-- Search Bar -->
        <div class="mt-2.5 relative">
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="thread-search" placeholder="Search conversations by name, email, service..."
            class="w-full pl-9 pr-3 py-1.5 text-xs bg-gray-50 border border-gray-200 rounded-lg focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary-500 transition">
        </div>
      </div>

      <!-- Threads Scroll List -->
      <div id="threads-container" class="flex-1 overflow-y-auto divide-y divide-gray-100 p-1">
        <div class="text-center py-12 text-gray-400 text-xs">
          <svg class="w-6 h-6 mx-auto mb-2 text-gray-300 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg>
          Loading conversations...
        </div>
      </div>
    </div>

    <!-- ── Right Panel: Active Chat Thread (md:col-span-7 lg:col-span-8) ── -->
    <div class="md:col-span-7 lg:col-span-8 flex flex-col h-full bg-white relative">
      
      <!-- Empty state when no thread is selected -->
      <div id="chat-empty-state" class="flex-1 flex flex-col items-center justify-center p-8 text-center bg-gray-50/30">
        <div class="w-16 h-16 rounded-2xl bg-primary-50 text-primary-600 flex items-center justify-center mb-4 shadow-inner">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        </div>
        <h3 class="text-base font-bold text-gray-900">Select a Conversation</h3>
        <p class="text-xs text-gray-500 max-w-sm mt-1">Pick an inquiry from a prospective customer or a booking consultation on the left to start replying in real time.</p>
      </div>

      <!-- Active Thread View -->
      <div id="chat-active-state" class="hidden flex-1 flex flex-col h-full overflow-hidden">
        
        <!-- Active Thread Header -->
        <div class="px-6 py-3.5 border-b border-gray-200 bg-white flex items-center justify-between shadow-2xs z-10">
          <div class="flex items-center gap-3 min-w-0">
            <div id="active-avatar" class="w-10 h-10 rounded-full bg-primary-100 text-primary-700 font-bold text-sm flex items-center justify-center flex-shrink-0">
              ?
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 id="active-name" class="font-bold text-gray-900 text-sm truncate">Customer</h3>
                <span id="active-type-badge" class="px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200">Inquiry</span>
              </div>
              <p id="active-subtitle" class="text-xs text-gray-400 truncate">customer@example.com</p>
            </div>
          </div>
          
          <!-- Booking details link (if booking chat) -->
          <div id="active-booking-action" class="hidden flex items-center gap-2">
            <a id="active-booking-link" href="#" target="_blank"
              class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-primary-700 bg-primary-50 hover:bg-primary-100 border border-primary-200 rounded-lg transition">
              <span>View Booking Record</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>

        <!-- Message Stream -->
        <div id="active-messages-container" class="flex-1 overflow-y-auto p-6 space-y-3 bg-gray-50/60">
          <!-- Dynamically injected message bubbles -->
        </div>

        <!-- Reply Input Composer -->
        <form id="active-chat-form" class="p-4 bg-white border-t border-gray-200 flex items-end gap-2.5">
          <div class="flex-1 min-w-0">
            <textarea id="active-chat-input" rows="1" placeholder="Type your reply here... (Press Enter to send, Shift+Enter for newline)"
              class="w-full px-4 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 resize-none max-h-32 transition leading-relaxed"></textarea>
          </div>
          <button type="submit" id="active-send-btn"
            class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white text-sm font-semibold rounded-xl shadow-xs transition flex items-center gap-1.5 flex-shrink-0 cursor-pointer disabled:opacity-50">
            <span>Send</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
        </form>

      </div>
    </div>

  </div>
</div>

<script src="https://cdn.socket.io/4.6.2/socket.io.min.js"></script>
<script>
(function() {
  var tenantId = "<%= tenant.id %>";
  var initialThreadId = "<%= initialThreadId || '' %>";
  var currentTab = "INQUIRIES"; // 'INQUIRIES', 'BOOKINGS', or 'STAFF'
  var threadsData = { inquiries: [], bookings: [], staff: [] };
  var activeThread = null;
  var socket = null;

  var tabInquiriesBtn = document.getElementById("tab-inquiries-btn");
  var tabBookingsBtn = document.getElementById("tab-bookings-btn");
  var tabStaffBtn = document.getElementById("tab-staff-btn");
  var tabInquiriesCount = document.getElementById("tab-inquiries-count");
  var tabBookingsCount = document.getElementById("tab-bookings-count");
  var tabStaffCount = document.getElementById("tab-staff-count");
  var tabInquiriesBadge = document.getElementById("tab-inquiries-badge");
  var tabBookingsBadge = document.getElementById("tab-bookings-badge");
  var tabStaffBadge = document.getElementById("tab-staff-badge");
  var searchInput = document.getElementById("thread-search");
  var threadsContainer = document.getElementById("threads-container");

  var emptyState = document.getElementById("chat-empty-state");
  var activeState = document.getElementById("chat-active-state");
  var activeAvatar = document.getElementById("active-avatar");
  var activeName = document.getElementById("active-name");
  var activeSubtitle = document.getElementById("active-subtitle");
  var activeTypeBadge = document.getElementById("active-type-badge");
  var activeBookingAction = document.getElementById("active-booking-action");
  var activeBookingLink = document.getElementById("active-booking-link");
  var messagesContainer = document.getElementById("active-messages-container");
  var form = document.getElementById("active-chat-form");
  var input = document.getElementById("active-chat-input");
  var sendBtn = document.getElementById("active-send-btn");

  window.switchTab = function(tab) {
    currentTab = tab;
    var activeClass = "flex-1 py-2 px-1.5 rounded-lg text-center transition flex items-center justify-center gap-1 bg-white text-gray-900 shadow-xs font-semibold cursor-pointer";
    var inactiveClass = "flex-1 py-2 px-1.5 rounded-lg text-center transition flex items-center justify-center gap-1 text-gray-500 hover:text-gray-900 font-medium cursor-pointer";

    if (tab === "INQUIRIES") {
      tabInquiriesBtn.className = activeClass;
      tabBookingsBtn.className = inactiveClass;
      tabStaffBtn.className = inactiveClass;
    } else if (tab === "BOOKINGS") {
      tabBookingsBtn.className = activeClass;
      tabInquiriesBtn.className = inactiveClass;
      tabStaffBtn.className = inactiveClass;
    } else {
      tabStaffBtn.className = activeClass;
      tabInquiriesBtn.className = inactiveClass;
      tabBookingsBtn.className = inactiveClass;
    }
    renderThreadsList();
  };

  function escapeHtml(str) {
    if (!str) return '';
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function formatTime(iso) {
    try {
      if (!iso) return '';
      var d = new Date(iso);
      var now = new Date();
      if (d.toDateString() === now.toDateString()) {
        return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }
      return d.toLocaleDateString([], { month: 'short', day: 'numeric' });
    } catch(e) { return ''; }
  }

  function renderThreadsList() {
    var list = (currentTab === "INQUIRIES") ? (threadsData.inquiries || []) : ((currentTab === "BOOKINGS") ? (threadsData.bookings || []) : (threadsData.staff || []));
    var query = (searchInput.value || '').toLowerCase().trim();

    if (query) {
      list = list.filter(function(t) {
        var name = (t.participantName || t.customerName || t.senderName || t.title || '').toLowerCase();
        var email = (t.participantEmail || t.customerEmail || t.senderEmail || '').toLowerCase();
        var sName = (t.booking?.service?.name || t.staff?.roleTitle || '').toLowerCase();
        var msg = (typeof t.lastMessage === 'string' ? t.lastMessage : (t.lastMessage ? t.lastMessage.message : '')).toLowerCase();
        return name.includes(query) || email.includes(query) || sName.includes(query) || msg.includes(query);
      });
    }

    if (!list || list.length === 0) {
      if (currentTab === "INQUIRIES") {
        threadsContainer.innerHTML = '<div class="text-center py-12 px-4 text-gray-500 text-xs flex flex-col items-center">' +
          '<div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mb-3">' +
          '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>' +
          '</div>' +
          '<p class="font-bold text-gray-800 text-sm">No general inquiries found</p>' +
          '<p class="text-gray-400 mt-1 max-w-xs leading-relaxed">Website visitors can ask questions from your public business page. When an inquiry is submitted, it will appear here in real time.</p>' +
          '<a href="/business/<%= tenant.slug %>" target="_blank" class="mt-3.5 inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:text-primary-700 bg-primary-50 px-3 py-1.5 rounded-lg border border-primary-200">' +
          '<span>View Public Business Page</span>' +
          '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>' +
          '</a>' +
          '</div>';
      } else if (currentTab === "BOOKINGS") {
        threadsContainer.innerHTML = '<div class="text-center py-12 px-4 text-gray-500 text-xs flex flex-col items-center">' +
          '<div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3">' +
          '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>' +
          '</div>' +
          '<p class="font-bold text-gray-800 text-sm">No booking consultations found</p>' +
          '<p class="text-gray-400 mt-1 max-w-xs leading-relaxed">When appointments are booked, consultation channels will automatically appear here so you can chat directly with your customers.</p>' +
          '<a href="/dashboard/bookings" class="mt-3.5 inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:text-primary-700 bg-primary-50 px-3 py-1.5 rounded-lg border border-primary-200">' +
          '<span>View All Appointments</span>' +
          '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>' +
          '</a>' +
          '</div>';
      } else {
        threadsContainer.innerHTML = '<div class="text-center py-12 px-4 text-gray-500 text-xs flex flex-col items-center">' +
          '<div class="w-12 h-12 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center mb-3">' +
          '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>' +
          '</div>' +
          '<p class="font-bold text-gray-800 text-sm">No staff members on team yet</p>' +
          '<p class="text-gray-400 mt-1 max-w-xs leading-relaxed">Add staff members to your business to enable internal team chat, provide login credentials, and assign appointments.</p>' +
          '<a href="/dashboard/staff" class="mt-3.5 inline-flex items-center gap-1 text-xs font-semibold text-primary-600 hover:text-primary-700 bg-primary-50 px-3 py-1.5 rounded-lg border border-primary-200">' +
          '<span>Manage Staff Members</span>' +
          '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>' +
          '</a>' +
          '</div>';
      }
      return;
    }

    var html = '';
    list.forEach(function(t) {
      var isSelected = activeThread && (activeThread.threadId === t.threadId);
      var name = t.participantName || t.customerName || t.senderName || t.title || (t.threadId.replace('inquiry_', '').replace('booking_', '').replace('staff_', ''));
      var email = t.participantEmail || t.customerEmail || t.senderEmail || '';
      var initial = (name.charAt(0) || '?').toUpperCase();
      var snippet = (typeof t.lastMessage === 'string' ? t.lastMessage : (t.lastMessage ? t.lastMessage.message : '')) || 'No messages yet';
      var time = t.lastMessageAt ? formatTime(t.lastMessageAt) : (t.lastMessage && t.lastMessage.createdAt ? formatTime(t.lastMessage.createdAt) : '');

      html += '<div onclick="selectThread(\'' + t.threadId + '\')" class="p-3 rounded-xl cursor-pointer transition flex items-start gap-3 ' +
        (isSelected ? 'bg-primary-50/90 border border-primary-200' : 'hover:bg-white border border-transparent') + '">';
      
      html += '<div class="w-9 h-9 rounded-full bg-primary-100 text-primary-700 font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">' +
        initial + '</div>';

      html += '<div class="flex-1 min-w-0">';
      html += '<div class="flex items-center justify-between gap-1 mb-0.5">';
      html += '<h4 class="text-xs font-bold text-gray-900 truncate">' + escapeHtml(name) + '</h4>';
      html += '<span class="text-[10px] text-gray-400 flex-shrink-0">' + time + '</span>';
      html += '</div>';

      if (t.type === "BOOKING" || t.booking) {
        var sName = t.booking?.service?.name || 'Appointment Consultation';
        var statusBadge = t.booking?.status ? '<span class="text-[9px] px-1.5 py-0.2 rounded font-semibold bg-gray-100 text-gray-600 uppercase">' + t.booking.status + '</span>' : '';
        html += '<div class="flex items-center gap-1.5 text-[11px] text-primary-700 font-medium truncate mb-0.5"><span>🗓 ' + escapeHtml(sName) + '</span>' + statusBadge + '</div>';
      } else if (t.type === "STAFF" || t.threadId.startsWith('staff_')) {
        var role = t.staff?.roleTitle || 'Specialist';
        html += '<p class="text-[11px] text-indigo-700 font-medium truncate mb-0.5">👤 ' + escapeHtml(role) + (email ? ' &bull; ' + escapeHtml(email) : '') + '</p>';
      } else {
        html += '<p class="text-[11px] text-gray-500 truncate mb-0.5">✉️ ' + escapeHtml(email || 'Website Visitor') + '</p>';
      }

      html += '<div class="flex items-center justify-between gap-2">';
      html += '<p class="text-[11px] text-gray-400 truncate flex-1">' + escapeHtml(snippet) + '</p>';
      if (t.unreadCount > 0) {
        html += '<span class="px-1.5 py-0.2 rounded-full bg-red-500 text-white text-[10px] font-bold flex-shrink-0 animate-pulse">' + t.unreadCount + '</span>';
      }
      html += '</div>';

      html += '</div></div>';
    });

    threadsContainer.innerHTML = html;
  }

  async function loadThreads() {
    try {
      var res = await fetch('/api/v1/chat/threads?tenantId=' + encodeURIComponent(tenantId));
      if (!res.ok) throw new Error('Failed to load threads');
      var data = await res.json();
      threadsData.inquiries = data.inquiries || [];
      threadsData.bookings = data.bookings || [];
      threadsData.staff = data.staff || [];

      // Update badge counters & tab total counts
      var unreadInq = threadsData.inquiries.reduce(function(acc, t){ return acc + (t.unreadCount || 0); }, 0);
      var unreadBkg = threadsData.bookings.reduce(function(acc, t){ return acc + (t.unreadCount || 0); }, 0);
      var unreadStf = threadsData.staff.reduce(function(acc, t){ return acc + (t.unreadCount || 0); }, 0);

      if (tabInquiriesCount) tabInquiriesCount.textContent = threadsData.inquiries.length;
      if (tabBookingsCount) tabBookingsCount.textContent = threadsData.bookings.length;
      if (tabStaffCount) tabStaffCount.textContent = threadsData.staff.length;

      if (unreadInq > 0) {
        tabInquiriesBadge.textContent = unreadInq;
        tabInquiriesBadge.classList.remove('hidden');
      } else {
        tabInquiriesBadge.classList.add('hidden');
      }

      if (unreadBkg > 0) {
        tabBookingsBadge.textContent = unreadBkg;
        tabBookingsBadge.classList.remove('hidden');
      } else {
        tabBookingsBadge.classList.add('hidden');
      }

      if (unreadStf > 0) {
        tabStaffBadge.textContent = unreadStf;
        tabStaffBadge.classList.remove('hidden');
      } else {
        tabStaffBadge.classList.add('hidden');
      }

      // If initial thread specified, auto open it
      if (initialThreadId && !activeThread) {
        selectThread(initialThreadId);
      } else {
        renderThreadsList();
      }
    } catch (err) {
      threadsContainer.innerHTML = '<div class="text-center py-12 text-red-500 text-xs">Failed to load conversations: ' + err.message + '</div>';
    }
  }

  window.selectThread = async function(threadId) {
    // Find thread in any category
    var found = (threadsData.inquiries || []).find(function(t){ return t.threadId === threadId; }) ||
                (threadsData.bookings || []).find(function(t){ return t.threadId === threadId; }) ||
                (threadsData.staff || []).find(function(t){ return t.threadId === threadId; });

    activeThread = found || { threadId: threadId };

    // Auto-switch tab if thread belongs to another category
    if (threadId.startsWith('booking_') && currentTab !== 'BOOKINGS') {
      switchTab('BOOKINGS');
    } else if (threadId.startsWith('inquiry_') && currentTab !== 'INQUIRIES') {
      switchTab('INQUIRIES');
    } else if (threadId.startsWith('staff_') && currentTab !== 'STAFF') {
      switchTab('STAFF');
    } else {
      renderThreadsList();
    }

    emptyState.classList.add('hidden');
    activeState.classList.remove('hidden');

    var displayName = activeThread.participantName || activeThread.customerName || activeThread.senderName || activeThread.title || threadId.replace('inquiry_', '').replace('booking_', '').replace('staff_', '');
    var displayEmail = activeThread.participantEmail || activeThread.customerEmail || activeThread.senderEmail || '';

    activeName.textContent = displayName;
    activeSubtitle.textContent = displayEmail || (threadId.startsWith('booking_') ? 'Booked Customer' : (threadId.startsWith('staff_') ? 'Staff Specialist' : 'Website Visitor'));
    activeAvatar.textContent = (displayName.charAt(0) || '?').toUpperCase();

    if (threadId.startsWith('booking_')) {
      activeTypeBadge.textContent = 'Booking Consultation';
      activeTypeBadge.className = 'px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200';
      var bId = activeThread.bookingId || threadId.replace('booking_', '');
      activeBookingLink.href = '/dashboard/bookings/' + bId;
      activeBookingLink.querySelector('span').textContent = 'View Booking Record';
      activeBookingAction.classList.remove('hidden');
    } else if (threadId.startsWith('staff_')) {
      activeTypeBadge.textContent = 'Staff Team Chat';
      activeTypeBadge.className = 'px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-indigo-100 text-indigo-800 border border-indigo-200';
      activeBookingLink.href = '/dashboard/staff';
      activeBookingLink.querySelector('span').textContent = 'Staff & Credentials';
      activeBookingAction.classList.remove('hidden');
    } else {
      activeTypeBadge.textContent = 'General Inquiry';
      activeTypeBadge.className = 'px-2.5 py-0.5 text-[10px] font-semibold rounded-full bg-blue-100 text-blue-800 border border-blue-200';
      activeBookingAction.classList.add('hidden');
    }

    // Join room in socket
    if (socket) {
      socket.emit('join:thread', threadId);
    }

    loadActiveMessages(threadId);

    // Mark as read on server
    fetch('/api/v1/chat/read', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ threadId: threadId, tenantId: tenantId })
    }).then(function() {
      if (activeThread.unreadCount) {
        activeThread.unreadCount = 0;
        renderThreadsList();
      }
    }).catch(function(){});
  };

  async function loadActiveMessages(threadId) {
    messagesContainer.innerHTML = '<div class="text-center py-10 text-gray-400 text-xs">' +
      '<svg class="w-6 h-6 mx-auto mb-2 text-gray-300 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg>' +
      'Loading conversation history...</div>';

    try {
      var res = await fetch('/api/v1/chat/messages?threadId=' + encodeURIComponent(threadId) + '&tenantId=' + encodeURIComponent(tenantId));
      if (!res.ok) throw new Error('Failed to load thread');
      var data = await res.json();
      renderActiveMessages(data.messages || []);
    } catch (err) {
      messagesContainer.innerHTML = '<div class="text-center py-10 text-red-500 text-xs">Error loading messages: ' + err.message + '</div>';
    }
  }

  function renderActiveMessages(messages) {
    if (!messages || messages.length === 0) {
      messagesContainer.innerHTML = '<div class="text-center py-16 text-gray-400 text-xs flex flex-col items-center">' +
        '<div class="w-12 h-12 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center mb-3">' +
        '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>' +
        '</div>' +
        '<p class="font-bold text-gray-700 text-sm">No messages in this conversation yet</p>' +
        '<p class="text-gray-400 mt-1 max-w-xs">Type your reply below to start the conversation with the client in real time.</p>' +
        '</div>';
      return;
    }

    var html = '';
    messages.forEach(function(m) {
      var isMe = (m.senderType === 'OWNER');
      var senderLabel = isMe ? 'You (Owner)' : (m.senderName || 'Customer');
      var timeStr = formatTime(m.createdAt);

      html += '<div class="flex flex-col ' + (isMe ? 'items-end' : 'items-start') + '">';
      html += '<div class="flex items-center gap-1.5 mb-1 text-[11px] text-gray-400">';
      html += '<span class="font-semibold text-gray-700">' + escapeHtml(senderLabel) + '</span>';
      html += '<span>•</span>';
      html += '<span>' + timeStr + '</span>';
      html += '</div>';
      html += '<div class="max-w-[75%] px-4 py-2.5 rounded-2xl text-xs sm:text-sm leading-relaxed shadow-2xs ' +
        (isMe ? 'bg-primary-600 text-white rounded-tr-xs' : 'bg-white border border-gray-200 text-gray-800 rounded-tl-xs') + '">';
      html += escapeHtml(m.message);
      html += '</div>';
      html += '</div>';
    });

    messagesContainer.innerHTML = html;
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  // Auto-expand textarea & handle enter to send
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      form.dispatchEvent(new Event('submit'));
    }
  });

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    if (!activeThread) return;

    var text = input.value.trim();
    if (!text) return;

    sendBtn.disabled = true;
    input.value = '';

    var threadId = activeThread.threadId;
    var isBooking = threadId.startsWith('booking_');
    var isStaff = threadId.startsWith('staff_');
    var recipientEmail = activeThread.participantEmail || activeThread.customerEmail || activeThread.senderEmail || (threadId.startsWith('inquiry_') ? threadId.replace('inquiry_', '') : null);

    try {
      var body = {
        tenantId: tenantId,
        threadId: threadId,
        recipientEmail: recipientEmail,
        senderType: 'OWNER',
        message: text
      };

      if (isBooking) {
        body.bookingId = activeThread.bookingId || threadId.replace('booking_', '');
      } else if (isStaff) {
        body.staffId = activeThread.staffId || threadId.replace('staff_', '');
      } else {
        body.visitorEmail = recipientEmail;
      }

      var res = await fetch('/api/v1/chat/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });

      if (!res.ok) {
        var errD = await res.json();
        throw new Error(errD.message || 'Failed to send message');
      }

      loadActiveMessages(threadId);
      loadThreads();
    } catch (err) {
      alert('Error sending: ' + err.message);
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  });

  searchInput.addEventListener('input', renderThreadsList);

  // Initialize Socket.io
  try {
    socket = io();
    socket.emit('join:tenant', tenantId);

    socket.on('chat:notification', function(notif) {
      loadThreads();
      if (activeThread && activeThread.threadId === notif.threadId) {
        loadActiveMessages(activeThread.threadId);
      }
    });

    socket.on('chat:message', function(msg) {
      if (activeThread && activeThread.threadId === msg.threadId) {
        loadActiveMessages(activeThread.threadId);
      }
    });
  } catch (e) {
    console.warn('Socket client init warning:', e);
  }

  // Initial load
  loadThreads();
})();
</script>
