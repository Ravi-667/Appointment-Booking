<!-- Calendar view -->
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Calendar</h1>
    <form class="mt-3 sm:mt-0 flex items-center space-x-2" method="GET" action="/dashboard/calendar">
      <input type="date" name="date" value="<%= date %>" class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm">
      <button type="submit" class="px-4 py-1.5 bg-primary-600 text-white rounded-lg text-sm hover:bg-primary-700 transition">Go</button>
    </form>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">
      <%= new Date(date).toLocaleDateString('en-IN', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %>
    </h2>
    <% if (bookings && bookings.length > 0) { %>
      <div class="space-y-2">
        <% bookings.forEach(b => { %>
        <a href="/dashboard/bookings/<%= b.id %>" class="flex items-center p-4 border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-sm transition">
          <div class="w-20 text-center">
            <p class="text-base font-bold text-primary-600"><%= formatTime12(b.startTime) %></p>
            <p class="text-xs text-gray-400"><%= b.service ? b.service.durationMinutes + ' min' : '' %></p>
          </div>
          <div class="ml-4 flex-1 border-l border-gray-200 pl-4">
            <p class="font-medium text-gray-900"><%= b.customerName %></p>
            <p class="text-sm text-gray-500"><%= b.service ? b.service.name : '' %> <% if (b.staff) { %>· <%= b.staff.name %><% } %></p>
          </div>
          <div>
            <% const c = { CONFIRMED:'green', PENDING_PAYMENT:'yellow' }; %>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-<%= c[b.status] || 'gray' %>-100 text-<%= c[b.status] || 'gray' %>-800"><%= b.status %></span>
          </div>
        </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-12">
        <p class="text-gray-400">No bookings for this date.</p>
      </div>
    <% } %>
  </div>
</div>
