<!-- Business settings + hours + holidays -->
<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Business Settings</h1>
      <p class="text-sm text-gray-500 mt-1">Configure your business details, operating hours, and booking link</p>
    </div>
    <a href="/dashboard" class="inline-flex items-center text-sm font-medium text-primary-600 hover:text-primary-700">
      ← Back to Dashboard
    </a>
  </div>

  <div class="space-y-6">

    <!-- Business Info -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Business Information</h2>
      <form action="/dashboard/settings/info" method="POST" class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Business Name</label>
            <input type="text" name="name" value="<%= tenant.name %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
            <input type="text" name="category" value="<%= tenant.category || '' %>" placeholder="e.g. Salon, Clinic" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
            <input type="tel" name="phone" value="<%= tenant.phone || '' %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Timezone</label>
            <input type="text" name="timezone" value="<%= tenant.timezone %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Address</label>
          <textarea name="address" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none"><%= tenant.address || '' %></textarea>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Lead Time (hours)</label>
            <input type="number" name="bookingLeadTimeHours" value="<%= tenant.bookingLeadTimeHours %>" min="0" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Advance Limit (days)</label>
            <input type="number" name="bookingAdvanceLimitDays" value="<%= tenant.bookingAdvanceLimitDays %>" min="1" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Buffer (minutes)</label>
            <input type="number" name="bufferMinutes" value="<%= tenant.bufferMinutes %>" min="0" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
          </div>
        </div>
        <button type="submit" class="px-6 py-2 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition">Save Changes</button>
      </form>
    </div>

    <!-- Business Hours -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Business Hours</h2>
      <form action="/dashboard/settings/hours" method="POST">
        <div class="space-y-2">
          <% const dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']; %>
          <% if (tenant.businessHours) { tenant.businessHours.forEach(h => { %>
          <div class="flex items-center space-x-3 p-3 rounded-lg bg-gray-50">
            <label class="flex items-center w-28">
              <input type="checkbox" name="hours[<%= h.dayOfWeek %>][isOpen]" value="true" <%= h.isOpen ? 'checked' : '' %> class="w-4 h-4 text-primary-600 border-gray-300 rounded">
              <span class="ml-2 text-sm font-medium text-gray-700"><%= dayNames[h.dayOfWeek] %></span>
            </label>
            <input type="hidden" name="hours[<%= h.dayOfWeek %>][dayOfWeek]" value="<%= h.dayOfWeek %>">
            <input type="time" name="hours[<%= h.dayOfWeek %>][openTime]" value="<%= h.openTime %>" class="px-2 py-1 border border-gray-300 rounded text-sm">
            <span class="text-gray-400">to</span>
            <input type="time" name="hours[<%= h.dayOfWeek %>][closeTime]" value="<%= h.closeTime %>" class="px-2 py-1 border border-gray-300 rounded text-sm">
            <% if (h.isOpen) { %>
              <span class="text-xs text-primary-700 bg-primary-50 px-2 py-0.5 rounded font-medium ml-2"><%= formatTimeRange12(h.openTime, h.closeTime) %></span>
            <% } %>
          </div>
          <% }) } %>
        </div>
        <button type="submit" class="mt-4 px-6 py-2 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition">Update Hours</button>
      </form>
    </div>

    <!-- Holidays -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Holidays</h2>
      <form action="/dashboard/settings/holidays" method="POST" class="flex items-end gap-3 mb-4">
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-700 mb-1">Date</label>
          <input type="date" name="date" required class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
        <div class="flex-1">
          <label class="block text-sm font-medium text-gray-700 mb-1">Reason</label>
          <input type="text" name="reason" placeholder="e.g. Diwali" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
        </div>
        <button type="submit" class="px-4 py-2 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition">Add</button>
      </form>
      <% if (tenant.holidays && tenant.holidays.length > 0) { %>
      <div class="space-y-2">
        <% tenant.holidays.forEach(h => { %>
        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg text-sm">
          <span><strong><%= new Date(h.date).toLocaleDateString('en-IN', { year:'numeric', month:'short', day:'numeric' }) %></strong> <% if (h.reason) { %> — <%= h.reason %><% } %></span>
          <form action="/dashboard/settings/holidays/<%= h.id %>/delete" method="POST">
            <button type="submit" class="text-red-500 hover:text-red-700 text-xs">Remove</button>
          </form>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <p class="text-sm text-gray-400">No holidays set.</p>
      <% } %>
    </div>

    <!-- ── Public Booking Link Card (Positioned at Bottom of Page) ───────── -->
    <div class="bg-gradient-to-br from-white to-primary-50/40 rounded-2xl shadow-sm border border-primary-200/80 p-6 relative overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center text-primary-600 flex-shrink-0 shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
          </div>
          <div>
            <h2 class="text-base font-bold text-gray-900">Your Public Booking Page</h2>
            <p class="text-xs text-gray-500 mt-0.5">Share this link with customers to accept online appointments 24/7</p>
          </div>
        </div>

        <span class="self-start sm:self-auto inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Live & Public
        </span>
      </div>

      <!-- URL Input + Copy + Open Actions -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 bg-white rounded-xl border border-gray-200 p-2 shadow-inner focus-within:ring-2 focus-within:ring-primary-500 focus-within:border-primary-500 transition">
        <div class="flex items-center gap-2 flex-1 px-2 py-1 min-w-0">
          <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
          <input type="text" id="settings-public-url" readonly
            value="<%= typeof reqProtocol !== 'undefined' ? reqProtocol : 'http' %>://<%= typeof reqHost !== 'undefined' ? reqHost : 'localhost:3000' %>/business/<%= tenant.slug %>"
            onclick="this.select()"
            class="w-full text-xs sm:text-sm text-gray-800 bg-transparent outline-none font-medium truncate select-all cursor-pointer">
        </div>

        <div class="flex items-center gap-2 flex-shrink-0">
          <button type="button" id="btn-copy-settings-url"
            onclick="copySettingsUrl(this)"
            class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white text-xs sm:text-sm font-semibold rounded-lg shadow-sm transition cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span>Copy Link</span>
          </button>

          <a href="/business/<%= tenant.slug %>" target="_blank"
            class="inline-flex items-center justify-center gap-1 px-3 py-2 border border-gray-200 bg-gray-50 hover:bg-gray-100 text-gray-700 text-xs sm:text-sm font-medium rounded-lg transition"
            title="Open booking page in new tab">
            <span>Visit</span>
            <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Share Tips / Channels -->
      <div class="mt-4 pt-3 border-t border-primary-100 flex flex-wrap items-center justify-between gap-3 text-xs text-gray-500">
        <div class="flex items-center gap-2">
          <span class="font-medium text-gray-700">Quick Share:</span>
          <a id="whatsapp-share-link"
            href="https://api.whatsapp.com/send?text=Book%20your%20appointment%20online%20at%20<%= encodeURIComponent(tenant.name) %>%3A%20<%= encodeURIComponent((typeof reqProtocol !== 'undefined' ? reqProtocol : 'http') + '://' + (typeof reqHost !== 'undefined' ? reqHost : 'localhost:3000') + '/business/' + tenant.slug) %>"
            target="_blank"
            class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-green-50 text-green-700 border border-green-200 hover:bg-green-100 font-medium transition">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.044-1.127-.095-.27-.087-.61-.205-1.05-.395-1.859-.806-3.074-2.693-3.167-2.818-.095-.125-.751-.998-.751-1.905 0-.908.471-1.353.64-1.538.169-.185.37-.231.494-.231.124 0 .248.001.357.006.114.005.267-.043.417.319.155.373.53 1.294.577 1.389.047.095.078.206.015.331-.063.125-.094.204-.188.315-.094.111-.198.248-.283.333-.094.095-.192.198-.083.385.109.187.485.8 1.042 1.296.719.641 1.325.84 1.512.934.187.094.296.079.406-.048.11-.126.471-.548.597-.735.126-.188.251-.157.422-.094.172.063 1.096.517 1.284.611.188.094.313.141.36.219.046.078.046.453-.098.858z"/>
            </svg>
            WhatsApp
          </a>
        </div>
        <span class="text-gray-400">Add to your Instagram Bio or Google Business Profile</span>
      </div>
    </div>

  </div>
</div>

<script>
// Auto-detect browser origin for accurate live public link
(function() {
  try {
    var origin = window.location.origin;
    var input = document.getElementById('settings-public-url');
    var waLink = document.getElementById('whatsapp-share-link');
    if (input && origin) {
      var liveUrl = origin + '/business/<%= tenant.slug %>';
      input.value = liveUrl;
      if (waLink) {
        waLink.href = 'https://api.whatsapp.com/send?text=' + encodeURIComponent('Book your appointment online at <%= tenant.name %>: ' + liveUrl);
      }
    }
  } catch (e) {}
})();

function copySettingsUrl(btn) {
  var input = document.getElementById('settings-public-url');
  if (!input) return;
  var url = input.value;
  
  navigator.clipboard.writeText(url).then(function() {
    var origHtml = btn.innerHTML;
    btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg><span>Copied!</span>';
    btn.classList.remove('bg-primary-600', 'hover:bg-primary-700');
    btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
    
    setTimeout(function() {
      btn.innerHTML = origHtml;
      btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
      btn.classList.add('bg-primary-600', 'hover:bg-primary-700');
    }, 2200);
  }).catch(function() {
    input.select();
    document.execCommand('copy');
  });
}
</script>
