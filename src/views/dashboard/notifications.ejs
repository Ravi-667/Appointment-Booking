<!-- Notification logs -->
<div class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Notification Logs</h1>
  <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Channel</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Recipient</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Sent At</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Error</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% if (result.logs && result.logs.length > 0) { %>
            <% result.logs.forEach(log => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-sm font-medium text-gray-900"><%= log.type %></td>
              <td class="px-4 py-3 text-sm text-gray-700"><%= log.channel %></td>
              <td class="px-4 py-3 text-sm text-gray-700"><%= log.recipient %></td>
              <td class="px-4 py-3">
                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-<%= log.status === 'SENT' ? 'green' : log.status === 'FAILED' ? 'red' : 'yellow' %>-100 text-<%= log.status === 'SENT' ? 'green' : log.status === 'FAILED' ? 'red' : 'yellow' %>-800"><%= log.status %></span>
              </td>
              <td class="px-4 py-3 text-sm text-gray-500"><%= log.sentAt ? new Date(log.sentAt).toLocaleString('en-IN') : '—' %></td>
              <td class="px-4 py-3 text-sm text-red-500"><%= log.errorMessage || '' %></td>
            </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No notifications sent yet</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <% if (result.pages > 1) { %>
    <div class="flex items-center justify-between px-4 py-3 border-t border-gray-200 bg-gray-50">
      <p class="text-sm text-gray-500">Page <%= result.page %> of <%= result.pages %></p>
      <div class="flex space-x-1">
        <% for (let p = 1; p <= result.pages; p++) { %>
        <a href="/dashboard/notifications?page=<%= p %>"
          class="px-3 py-1 text-sm rounded <%= p === result.page ? 'bg-primary-600 text-white' : 'text-gray-600 hover:bg-gray-200' %>"><%= p %></a>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
</div>
