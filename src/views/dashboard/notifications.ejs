<!-- ═══════════════════════════════════════════════════════════
     Notifications & Activity Hub — Business Owner Dashboard
════════════════════════════════════════════════════════════ -->
<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  
  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-2.5">
        <svg class="w-7 h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        <span>Notifications Hub</span>
      </h1>
      <p class="text-sm text-gray-500 mt-1">Live alerts for bookings, cancellations, staff applications, chat inquiries, and delivery logs.</p>
    </div>

    <!-- Quick Action: Mark all read -->
    <div class="flex items-center gap-2">
      <form action="/dashboard/notifications/mark-all-read" method="POST">
        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-xl border border-gray-300 shadow-2xs transition cursor-pointer">
          <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>Mark All Read</span>
        </button>
      </form>
    </div>
  </div>

  <% 
    const notifs = (typeof inAppNotifications !== 'undefined' && inAppNotifications) ? inAppNotifications : [];
    const unread = (typeof unreadCount !== 'undefined') ? unreadCount : 0;
    const logsTotal = (result && typeof result.total !== 'undefined') ? result.total : 0;
  %>

  <!-- Quick KPI Counters -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6">
    <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-2xs">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block">Unread Alerts</span>
      <div class="flex items-center gap-2 mt-1">
        <p class="text-2xl font-bold <%= unread > 0 ? 'text-red-600' : 'text-gray-900' %>"><%= unread %></p>
        <% if (unread > 0) { %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-800 animate-pulse">Action Required</span>
        <% } %>
      </div>
      <span class="text-[11px] text-gray-400">new in-app notifications</span>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-2xs">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block">Total In-App Alerts</span>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= notifs.length %></p>
      <span class="text-[11px] text-gray-400">recorded activities</span>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 shadow-2xs col-span-2 sm:col-span-1">
      <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider block">Email & SMS Deliveries</span>
      <p class="text-2xl font-bold text-emerald-600 mt-1"><%= logsTotal %></p>
      <span class="text-[11px] text-emerald-600 font-medium">automated dispatches</span>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <div class="flex items-center border-b border-gray-200 mb-6 space-x-6 text-sm font-semibold">
    <button type="button" id="tab-feed-btn" onclick="switchNotifTab('FEED')"
      class="pb-3 border-b-2 <%= (typeof activeTab === 'undefined' || activeTab !== 'logs') ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-500 hover:text-gray-900' %> flex items-center gap-2 transition cursor-pointer">
      <span>Activity Feed</span>
      <% if (unread > 0) { %>
        <span class="px-2 py-0.5 rounded-full text-xs bg-red-100 text-red-800 font-bold"><%= unread %></span>
      <% } else { %>
        <span class="px-2 py-0.5 rounded-full text-xs bg-gray-100 text-gray-600"><%= notifs.length %></span>
      <% } %>
    </button>
    <button type="button" id="tab-logs-btn" onclick="switchNotifTab('LOGS')"
      class="pb-3 border-b-2 <%= (typeof activeTab !== 'undefined' && activeTab === 'logs') ? 'border-primary-600 text-primary-600' : 'border-transparent text-gray-500 hover:text-gray-900' %> flex items-center gap-2 transition cursor-pointer">
      <span>Delivery Audit Logs</span>
      <span class="px-2 py-0.5 rounded-full text-xs bg-gray-100 text-gray-600"><%= logsTotal %></span>
    </button>
  </div>

  <!-- ── Tab 1: Actionable Notification Feed ─────────────────── -->
  <div id="section-notif-feed" class="<%= (typeof activeTab !== 'undefined' && activeTab === 'logs') ? 'hidden' : '' %> space-y-3">
    <% if (notifs && notifs.length > 0) { %>
      <div class="space-y-3">
        <% notifs.forEach(n => { 
          const isConfirmed = (n.type === 'BOOKING_CONFIRMED');
          const isCancelled = (n.type === 'BOOKING_CANCELLED');
          const isStaffApp = (n.type === 'STAFF_APPLICATION');
          const isChat = (n.type === 'CHAT_MESSAGE');
        %>
        <div class="bg-white rounded-2xl border <%= !n.isRead ? 'border-primary-300 ring-2 ring-primary-50 shadow-sm' : 'border-gray-200 shadow-2xs' %> p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition hover:shadow-xs">
          
          <div class="flex items-start gap-3.5 min-w-0 flex-1">
            <!-- Icon -->
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-base font-bold
              <%= isConfirmed ? 'bg-emerald-100 text-emerald-700' : isCancelled ? 'bg-red-100 text-red-700' : isStaffApp ? 'bg-blue-100 text-blue-700' : isChat ? 'bg-purple-100 text-purple-700' : 'bg-primary-100 text-primary-700' %>">
              <% if (isConfirmed) { %>✓<% } else if (isCancelled) { %>✕<% } else if (isStaffApp) { %>💼<% } else if (isChat) { %>💬<% } else { %>🔔<% } %>
            </div>

            <!-- Details -->
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-bold text-sm text-gray-900 leading-tight"><%= n.title %></h3>
                <% if (!n.isRead) { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-primary-100 text-primary-800">New</span>
                <% } %>
                <span class="text-[11px] text-gray-400">• <%= new Date(n.createdAt).toLocaleDateString([], { day:'numeric', month:'short' }) %> at <%= new Date(n.createdAt).toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' }) %></span>
              </div>
              <p class="text-xs text-gray-600 mt-1 leading-relaxed"><%= n.message %></p>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-2 w-full sm:w-auto justify-end pt-2 sm:pt-0 border-t sm:border-t-0 border-gray-100 text-xs">
            <% if (n.link) { %>
              <a href="<%= n.link %>" class="px-3.5 py-1.5 <%= isChat ? 'bg-primary-600 hover:bg-primary-700 text-white shadow-2xs' : 'bg-primary-50 hover:bg-primary-100 text-primary-700' %> font-semibold rounded-lg transition cursor-pointer">
                <%= isChat ? 'Reply in Chat 💬' : isStaffApp ? 'Review Candidate 💼' : 'View Details' %>
              </a>
            <% } %>

            <% if (!n.isRead) { %>
              <form action="/dashboard/notifications/<%= n.id %>/read" method="POST">
                <button type="submit" title="Mark as read" class="px-2.5 py-1.5 text-gray-500 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition cursor-pointer">
                  ✓
                </button>
              </form>
            <% } %>

            <form action="/dashboard/notifications/<%= n.id %>/delete" method="POST" onsubmit="return confirm('Dismiss notification?')">
              <button type="submit" title="Dismiss" class="px-2.5 py-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition cursor-pointer">
                🗑
              </button>
            </form>
          </div>

        </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="bg-white rounded-2xl border border-gray-200 p-12 text-center shadow-xs">
        <div class="w-14 h-14 rounded-full bg-primary-50 text-primary-600 flex items-center justify-center mx-auto mb-3">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
        </div>
        <h3 class="text-base font-bold text-gray-900">No Notifications Yet</h3>
        <p class="text-xs text-gray-500 max-w-sm mx-auto mt-1">When customers book services, candidates apply for jobs, or messages arrive, notifications will appear here in real-time.</p>
      </div>
    <% } %>
  </div>

  <!-- ── Tab 2: Technical Transmission Logs ──────────────────── -->
  <div id="section-notif-logs" class="<%= (typeof activeTab !== 'undefined' && activeTab === 'logs') ? '' : 'hidden' %>">
    <div class="bg-white rounded-2xl shadow-xs border border-gray-200 overflow-hidden">
      <div class="px-5 py-4 border-b border-gray-200 bg-gray-50/70 flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-gray-900">Email & SMS Automated Transmissions</h3>
          <p class="text-xs text-gray-500 mt-0.5">Historical delivery status, recipient addresses, and error telemetry</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-gray-50 border-b border-gray-200 text-gray-500 uppercase tracking-wider font-semibold">
            <tr>
              <th class="px-5 py-3">Event Type</th>
              <th class="px-4 py-3">Channel</th>
              <th class="px-4 py-3">Recipient</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Sent At</th>
              <th class="px-4 py-3">Error Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-gray-700">
            <% if (result.logs && result.logs.length > 0) { %>
              <% result.logs.forEach(log => { %>
              <tr class="hover:bg-gray-50/80 transition">
                <td class="px-5 py-3 font-semibold text-gray-900"><%= log.type %></td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 rounded-md font-semibold text-[11px] <%= log.channel === 'EMAIL' ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-amber-50 text-amber-700 border border-amber-200' %>">
                    <%= log.channel %>
                  </span>
                </td>
                <td class="px-4 py-3 font-medium"><%= log.recipient %></td>
                <td class="px-4 py-3">
                  <% if (log.status === 'SENT') { %>
                    <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-emerald-100 text-emerald-800">✓ SENT</span>
                  <% } else if (log.status === 'FAILED') { %>
                    <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-red-100 text-red-800">✕ FAILED</span>
                  <% } else { %>
                    <span class="px-2 py-0.5 text-[11px] font-bold rounded-full bg-amber-100 text-amber-800">⋯ PENDING</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-gray-500"><%= log.sentAt ? formatDateTime12(log.sentAt) : '—' %></td>
                <td class="px-4 py-3 text-red-500 font-mono text-[11px]"><%= log.errorMessage || '—' %></td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="6" class="px-5 py-10 text-center text-gray-400">No transmission logs recorded yet</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (result.pages > 1) { %>
      <div class="flex items-center justify-between px-5 py-3 border-t border-gray-200 bg-gray-50 text-xs text-gray-600">
        <p>Page <%= result.page %> of <%= result.pages %> (<%= result.total %> records)</p>
        <div class="flex space-x-1">
          <% for (let p = 1; p <= result.pages; p++) { %>
          <a href="/dashboard/notifications?tab=logs&page=<%= p %>"
            class="px-3 py-1.5 rounded-lg font-semibold <%= p === result.page ? 'bg-primary-600 text-white' : 'text-gray-600 hover:bg-gray-200' %>"><%= p %></a>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
  </div>

</div>

<script>
  window.switchNotifTab = function(tab) {
    var feedSection = document.getElementById('section-notif-feed');
    var logsSection = document.getElementById('section-notif-logs');
    var feedBtn = document.getElementById('tab-feed-btn');
    var logsBtn = document.getElementById('tab-logs-btn');

    if (tab === 'FEED') {
      feedSection.classList.remove('hidden');
      logsSection.classList.add('hidden');
      feedBtn.className = 'pb-3 border-b-2 border-primary-600 text-primary-600 flex items-center gap-2 transition cursor-pointer font-semibold';
      logsBtn.className = 'pb-3 border-b-2 border-transparent text-gray-500 hover:text-gray-900 flex items-center gap-2 transition cursor-pointer font-semibold';
    } else {
      logsSection.classList.remove('hidden');
      feedSection.classList.add('hidden');
      logsBtn.className = 'pb-3 border-b-2 border-primary-600 text-primary-600 flex items-center gap-2 transition cursor-pointer font-semibold';
      feedBtn.className = 'pb-3 border-b-2 border-transparent text-gray-500 hover:text-gray-900 flex items-center gap-2 transition cursor-pointer font-semibold';
    }
  };
</script>
