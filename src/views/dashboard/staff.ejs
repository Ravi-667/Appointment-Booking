<!-- Staff management -->
<div class="max-w-5xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Staff</h1>
    <button onclick="document.getElementById('add-staff-modal').classList.remove('hidden')"
      class="px-4 py-2 bg-primary-600 text-white text-sm font-semibold rounded-lg hover:bg-primary-700 transition">+ Add Staff</button>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% if (staffList && staffList.length > 0) { %>
      <% staffList.forEach(s => { %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
        <div class="flex items-center space-x-3">
          <div class="w-12 h-12 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center font-bold text-lg">
            <%= s.name.charAt(0).toUpperCase() %>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900"><%= s.name %></h3>
            <% if (!s.isActive) { %><span class="text-xs text-gray-400">Inactive</span><% } %>
          </div>
        </div>
        <% if (s.bio) { %><p class="text-sm text-gray-500 mt-3"><%= s.bio %></p><% } %>
        <% if (s.staffServices && s.staffServices.length > 0) { %>
        <div class="mt-3 flex flex-wrap gap-1">
          <% s.staffServices.forEach(ss => { %>
            <span class="px-2 py-0.5 text-xs bg-primary-50 text-primary-700 rounded-full"><%= ss.service ? ss.service.name : '' %></span>
          <% }) %>
        </div>
        <% } %>
        <div class="mt-4 flex space-x-2">
          <form action="/dashboard/staff/<%= s.id %>/deactivate" method="POST" onsubmit="return confirm('Deactivate this staff member?')">
            <button type="submit" class="px-3 py-1 text-xs text-red-600 border border-red-200 rounded hover:bg-red-50 transition">Deactivate</button>
          </form>
        </div>
      </div>
      <% }) %>
    <% } else { %>
      <div class="sm:col-span-2 lg:col-span-3 bg-white rounded-xl border border-gray-200 p-12 text-center">
        <p class="text-gray-400 mb-4">No staff members yet.</p>
        <button onclick="document.getElementById('add-staff-modal').classList.remove('hidden')"
          class="px-4 py-2 bg-primary-600 text-white text-sm font-semibold rounded-lg">+ Add Staff</button>
      </div>
    <% } %>
  </div>
</div>

<!-- Add Staff Modal -->
<div id="add-staff-modal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold text-gray-900">Add Staff Member</h2>
      <button onclick="document.getElementById('add-staff-modal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-xl">&times;</button>
    </div>
    <form action="/dashboard/staff" method="POST" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Name *</label>
        <input type="text" name="name" required maxlength="100" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Bio</label>
        <textarea name="bio" rows="2" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none"></textarea>
      </div>
      <button type="submit" class="w-full py-2.5 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition">Add Staff</button>
    </form>
  </div>
</div>
