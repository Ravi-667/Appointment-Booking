<!-- Booking detail -->
<div class="max-w-3xl mx-auto px-4 py-8">
  <a href="/dashboard/bookings" class="text-sm text-primary-600 hover:text-primary-700 mb-4 inline-block">← Back to bookings</a>
  <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
    <div class="px-8 py-6 border-b border-gray-200 flex justify-between items-center">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Booking Details</h1>
        <p class="text-sm text-gray-500 mt-1">ID: <code class="bg-gray-100 px-2 py-0.5 rounded text-xs"><%= booking.id %></code></p>
      </div>
      <% const sc = { CONFIRMED:'green', PENDING_PAYMENT:'yellow', CANCELLED:'red', RESCHEDULED:'blue', PAYMENT_FAILED:'red', NO_SHOW:'orange' }; %>
      <span class="px-3 py-1 text-sm font-semibold rounded-full bg-<%= sc[booking.status] || 'gray' %>-100 text-<%= sc[booking.status] || 'gray' %>-800"><%= booking.status %></span>
    </div>

    <div class="px-8 py-6 grid sm:grid-cols-2 gap-y-4 gap-x-8">
      <div><p class="text-sm text-gray-500">Customer</p><p class="font-medium text-gray-900"><%= booking.customerName %></p></div>
      <div><p class="text-sm text-gray-500">Email</p><p class="font-medium text-gray-900"><%= booking.customerEmail %></p></div>
      <div><p class="text-sm text-gray-500">Phone</p><p class="font-medium text-gray-900"><%= booking.customerPhone || '—' %></p></div>
      <div><p class="text-sm text-gray-500">Service</p><p class="font-medium text-gray-900"><%= booking.service ? booking.service.name : '—' %></p></div>
      <div><p class="text-sm text-gray-500">Staff</p><p class="font-medium text-gray-900"><%= booking.staff ? booking.staff.name : '—' %></p></div>
      <div><p class="text-sm text-gray-500">Date & Time</p><p class="font-medium text-gray-900"><%= formatDateTime12(booking.startTime) %></p></div>
      <div><p class="text-sm text-gray-500">Total Price</p><p class="font-medium text-gray-900">₹<%= Number(booking.price).toLocaleString() %></p></div>
      <div><p class="text-sm text-gray-500">Payment Mode</p><p class="font-semibold text-emerald-600">Full Payment (<%= booking.status === 'CONFIRMED' ? 'Paid' : booking.status %>)</p></div>
      <% if (booking.customerNotes) { %>
      <div class="sm:col-span-2"><p class="text-sm text-gray-500">Notes</p><p class="font-medium text-gray-900"><%= booking.customerNotes %></p></div>
      <% } %>
      <% if (booking.cancellationReason) { %>
      <div class="sm:col-span-2"><p class="text-sm text-gray-500">Cancellation Reason</p><p class="font-medium text-red-600"><%= booking.cancellationReason %></p></div>
      <% } %>
    </div>

    <% if (booking.payments && booking.payments.length > 0) { %>
    <div class="px-8 py-6 border-t border-gray-200">
      <h3 class="font-semibold text-gray-900 mb-3">Payments</h3>
      <div class="space-y-2">
        <% booking.payments.forEach(p => { %>
        <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg text-sm">
          <div>
            <span class="font-medium text-gray-900"><%= p.type === 'FULL_PAYMENT' || p.type === 'DEPOSIT' ? 'Full Payment' : p.type %></span>
            <span class="text-gray-500 ml-2"><%= p.razorpayPaymentId || p.razorpayOrderId || '—' %></span>
          </div>
          <div class="flex items-center space-x-3">
            <span class="font-medium">₹<%= Number(p.amount).toLocaleString() %></span>
            <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-<%= p.status === 'CAPTURED' ? 'green' : p.status === 'FAILED' ? 'red' : 'yellow' %>-100 text-<%= p.status === 'CAPTURED' ? 'green' : p.status === 'FAILED' ? 'red' : 'yellow' %>-800"><%= p.status %></span>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (['CONFIRMED','PENDING_PAYMENT'].includes(booking.status)) { %>
    <div class="px-8 py-6 border-t border-gray-200 flex flex-wrap gap-3">
      <form action="/dashboard/bookings/<%= booking.id %>/cancel" method="POST" onsubmit="return confirm('Cancel this booking?')">
        <input type="hidden" name="reason" value="Cancelled by business owner">
        <button type="submit" class="px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 transition">Cancel Booking</button>
      </form>
      <% if (booking.status === 'CONFIRMED') { %>
      <form action="/dashboard/bookings/<%= booking.id %>/no-show" method="POST" onsubmit="return confirm('Mark this booking as No-Show?')">
        <button type="submit" class="px-4 py-2 bg-orange-600 text-white text-sm font-medium rounded-lg hover:bg-orange-700 transition">Mark No-Show</button>
      </form>
      <% } %>
      <button id="reschedule-toggle-btn"
        class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 active:bg-indigo-800 shadow-sm transition flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Reschedule
      </button>
    </div>
    <div id="reschedule-form" class="hidden px-8 pb-6">
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-5">
        <h3 class="text-sm font-semibold text-indigo-800 mb-3 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Pick a new date & time
        </h3>
        <form action="/dashboard/bookings/<%= booking.id %>/reschedule" method="POST" class="flex flex-col sm:flex-row items-end gap-3">
          <div class="flex-1 w-full">
            <label class="block text-sm font-medium text-gray-700 mb-1">New Date & Time</label>
            <input type="datetime-local" name="newStartTime" required
              class="w-full px-4 py-2.5 border border-indigo-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none text-sm bg-white">
          </div>
          <div class="flex gap-2 w-full sm:w-auto">
            <button type="button" id="reschedule-cancel-btn"
              class="flex-1 sm:flex-none px-4 py-2.5 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-50 transition">
              Cancel
            </button>
            <button type="submit"
              class="flex-1 sm:flex-none px-5 py-2.5 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 shadow transition">
              Confirm Reschedule
            </button>
          </div>
        </form>
      </div>
    </div>
    <script>
      (function() {
        var toggleBtn  = document.getElementById('reschedule-toggle-btn');
        var cancelBtn  = document.getElementById('reschedule-cancel-btn');
        var formPanel  = document.getElementById('reschedule-form');
        if (!toggleBtn || !formPanel) return;

        toggleBtn.addEventListener('click', function() {
          formPanel.classList.toggle('hidden');
          toggleBtn.textContent = formPanel.classList.contains('hidden') ? '' : '';
          // keep icon + text in sync
          if (!formPanel.classList.contains('hidden')) {
            toggleBtn.innerHTML = '<svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>Close';
          } else {
            toggleBtn.innerHTML = '<svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>Reschedule';
          }
        });

        if (cancelBtn) {
          cancelBtn.addEventListener('click', function() {
            formPanel.classList.add('hidden');
            toggleBtn.innerHTML = '<svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>Reschedule';
          });
        }
      })();
    </script>
    <% } %>
    <!-- ── Customer Appointment Consultation Chat ────────────── -->
    <div class="px-8 py-6 border-t border-gray-200 bg-gray-50/60">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="font-bold text-gray-900 text-base flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            Customer Consultation Chat
          </h3>
          <p class="text-xs text-gray-500 mt-0.5">Direct appointment communication with <%= booking.customerName %></p>
        </div>
        <a href="/dashboard/chat?threadId=booking_<%= booking.id %>"
          class="text-xs font-semibold text-primary-600 hover:text-primary-700 bg-white border border-primary-200 px-3 py-1.5 rounded-lg shadow-2xs hover:bg-primary-50 transition flex items-center gap-1">
          <span>Open in Messages Hub</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 shadow-xs flex flex-col h-[380px] overflow-hidden">
        <!-- Message stream -->
        <div id="booking-chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3 bg-gray-50/50">
          <div class="text-center py-6 text-gray-400 text-xs">
            <svg class="w-8 h-8 mx-auto mb-2 text-gray-300 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg>
            Loading consultation history...
          </div>
        </div>

        <!-- Input box -->
        <form id="booking-chat-form" class="p-3 bg-white border-t border-gray-200 flex items-center gap-2">
          <input type="text" id="booking-chat-input"
            placeholder="Type a message to <%= booking.customerName %>..."
            class="flex-1 px-4 py-2 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-gray-50/50 focus:bg-white transition"
            autocomplete="off">
          <button type="submit" id="booking-chat-send-btn"
            class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-lg shadow-sm transition flex items-center gap-1.5 flex-shrink-0 cursor-pointer disabled:opacity-50">
            <span>Send</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
        </form>
      </div>
    </div>

    <script src="https://cdn.socket.io/4.6.2/socket.io.min.js"></script>
    <script>
      (function() {
        var bookingId = "<%= booking.id %>";
        var threadId = "booking_" + bookingId;
        var customerEmail = "<%= booking.customerEmail %>";
        var customerName = "<%= booking.customerName %>";
        var msgContainer = document.getElementById("booking-chat-messages");
        var form = document.getElementById("booking-chat-form");
        var input = document.getElementById("booking-chat-input");
        var sendBtn = document.getElementById("booking-chat-send-btn");

        function scrollToBottom() {
          if (msgContainer) {
            msgContainer.scrollTop = msgContainer.scrollHeight;
          }
        }

        function formatMsgTime(iso) {
          try {
            var d = new Date(iso);
            return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          } catch(e) { return ''; }
        }

        function renderMessages(messages) {
          if (!messages || messages.length === 0) {
            msgContainer.innerHTML = '<div class="text-center py-10 text-gray-400 text-xs">' +
              '<svg class="w-10 h-10 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>' +
              'No messages yet. Send a message to start communicating with the customer.' +
              '</div>';
            return;
          }

          var html = '';
          messages.forEach(function(m) {
            var isMe = (m.senderType === 'OWNER');
            html += '<div class="flex flex-col ' + (isMe ? 'items-end' : 'items-start') + '">';
            html += '<div class="flex items-center gap-1.5 mb-1 text-[11px] text-gray-400">';
            html += '<span class="font-semibold text-gray-700">' + (isMe ? 'You (Owner)' : (m.senderName || customerName)) + '</span>';
            html += '<span>•</span>';
            html += '<span>' + formatMsgTime(m.createdAt) + '</span>';
            html += '</div>';
            html += '<div class="max-w-[78%] px-3.5 py-2 rounded-2xl text-xs sm:text-sm leading-relaxed shadow-xs ' +
              (isMe ? 'bg-primary-600 text-white rounded-tr-xs' : 'bg-white border border-gray-200 text-gray-800 rounded-tl-xs') + '">';
            html += escapeHtml(m.message);
            html += '</div>';
            html += '</div>';
          });
          msgContainer.innerHTML = html;
          scrollToBottom();
        }

        function escapeHtml(text) {
          var div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }

        async function loadMessages() {
          try {
            var res = await fetch('/api/v1/chat/messages?bookingId=' + encodeURIComponent(bookingId));
            if (!res.ok) throw new Error('Failed to load messages');
            var data = await res.json();
            renderMessages(data.messages || []);
            // Mark as read
            fetch('/api/v1/chat/read', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ threadId: threadId })
            }).catch(function(){});
          } catch (err) {
            msgContainer.innerHTML = '<div class="text-center py-6 text-red-500 text-xs">Could not load chat messages.</div>';
          }
        }

        // Send message handler
        form.addEventListener('submit', async function(e) {
          e.preventDefault();
          var txt = input.value.trim();
          if (!txt) return;

          sendBtn.disabled = true;
          input.value = '';
          try {
            var res = await fetch('/api/v1/chat/messages', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                bookingId: bookingId,
                recipientEmail: customerEmail,
                senderType: 'OWNER',
                message: txt
              })
            });
            if (!res.ok) {
              var errData = await res.json();
              throw new Error(errData.message || 'Failed to send message');
            }
            loadMessages();
          } catch (err) {
            alert('Failed to send: ' + err.message);
          } finally {
            sendBtn.disabled = false;
            input.focus();
          }
        });

        // Initialize Socket.io
        try {
          var socket = io();
          socket.emit('join:thread', threadId);
          socket.on('chat:message', function(msg) {
            if (msg.threadId === threadId) {
              loadMessages();
            }
          });
        } catch (e) {
          console.warn('Socket connection note:', e);
        }

        // Initial load
        loadMessages();
      })();
    </script>
  </div>
</div>
