<!-- ═══════════════════════════════════════════════════════════
     Business Dashboard — Redesigned
════════════════════════════════════════════════════════════ -->
<div class="bg-gray-50 min-h-screen">

  <!-- ── Top header bar ─────────────────────────────────── -->
  <div class="bg-white border-b border-gray-200 sticky top-0 z-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Dashboard</h1>
        <p class="text-sm text-gray-500 mt-0.5">
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-primary-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm0-2a6 6 0 100-12 6 6 0 000 12z" clip-rule="evenodd"/><path d="M10 6a1 1 0 011 1v3.586l2.207 2.207a1 1 0 01-1.414 1.414l-2.5-2.5A1 1 0 019 11V7a1 1 0 011-1z"/></svg>
            <%= tenant.name %>
          </span>
        </p>
      </div>

      <!-- Period selector -->
      <div class="flex items-center gap-2">
        <label class="text-xs sm:text-sm text-gray-500 font-medium">Period:</label>
        <select id="period-select" onchange="window.location.href='/dashboard?period='+this.value"
          class="px-3 py-1.5 border border-gray-300 rounded-lg text-xs sm:text-sm bg-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none cursor-pointer font-medium text-gray-700 shadow-sm">
          <option value="1d" <%= stats.period === '1d' ? 'selected' : '' %>>Today</option>
          <option value="7d" <%= stats.period === '7d' ? 'selected' : '' %>>7 Days</option>
          <option value="30d" <%= stats.period === '30d' ? 'selected' : '' %>>30 Days</option>
          <option value="90d" <%= stats.period === '90d' ? 'selected' : '' %>>90 Days</option>
        </select>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- ── KPI Stat Cards ──────────────────────────────────── -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Total Bookings</p>
          <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-gray-900"><%= stats.total %></p>
        <p class="text-xs text-gray-400">in selected period</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Confirmed</p>
          <div class="w-8 h-8 bg-green-50 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-green-600"><%= stats.confirmed %></p>
        <p class="text-xs text-gray-400">appointments set</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Cancelled</p>
          <div class="w-8 h-8 bg-red-50 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-red-600"><%= stats.cancelled %></p>
        <p class="text-xs text-gray-400">cancellations</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-2">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Cancel Rate</p>
          <div class="w-8 h-8 bg-orange-50 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-orange-600"><%= stats.cancellationRate %>%</p>
        <p class="text-xs text-gray-400">of total bookings</p>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5 flex flex-col gap-2 col-span-2 sm:col-span-1">
        <div class="flex items-center justify-between">
          <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Revenue</p>
          <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <p class="text-3xl font-bold text-primary-600">₹<%= Number(stats.revenue).toLocaleString() %></p>
        <p class="text-xs text-gray-400">collected payments</p>
      </div>
    </div>

    <!-- ── Quick Actions bar ───────────────────────────────── -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <a href="/dashboard/bookings"
        class="bg-white border border-gray-200 rounded-xl p-4 flex items-center gap-3 hover:border-primary-300 hover:shadow-sm transition group">
        <div class="w-10 h-10 bg-primary-50 rounded-xl flex items-center justify-center group-hover:bg-primary-100 transition flex-shrink-0">
          <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-800 group-hover:text-primary-700">All Bookings</p>
          <p class="text-xs text-gray-400">View & manage</p>
        </div>
      </a>
      <a href="/dashboard/calendar"
        class="bg-white border border-gray-200 rounded-xl p-4 flex items-center gap-3 hover:border-purple-300 hover:shadow-sm transition group">
        <div class="w-10 h-10 bg-purple-50 rounded-xl flex items-center justify-center group-hover:bg-purple-100 transition flex-shrink-0">
          <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-800 group-hover:text-purple-700">Calendar</p>
          <p class="text-xs text-gray-400">Day view</p>
        </div>
      </a>
      <a href="/dashboard/services"
        class="bg-white border border-gray-200 rounded-xl p-4 flex items-center gap-3 hover:border-green-300 hover:shadow-sm transition group">
        <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center group-hover:bg-green-100 transition flex-shrink-0">
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-800 group-hover:text-green-700">Services</p>
          <p class="text-xs text-gray-400">Add & edit</p>
        </div>
      </a>
      <a href="/dashboard/staff"
        class="bg-white border border-gray-200 rounded-xl p-4 flex items-center gap-3 hover:border-orange-300 hover:shadow-sm transition group">
        <div class="w-10 h-10 bg-orange-50 rounded-xl flex items-center justify-center group-hover:bg-orange-100 transition flex-shrink-0">
          <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-800 group-hover:text-orange-700">Staff</p>
          <p class="text-xs text-gray-400">Manage team</p>
        </div>
      </a>
    </div>

    <!-- ── Main content: Upcoming + Today's Schedule ───────── -->
    <div class="grid lg:grid-cols-3 gap-6">

      <!-- Upcoming Bookings (wider) -->
      <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-200">
        <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100">
          <div>
            <h2 class="text-base font-semibold text-gray-900">Upcoming Bookings</h2>
            <p class="text-xs text-gray-400 mt-0.5">Next confirmed appointments</p>
          </div>
          <a href="/dashboard/bookings" class="text-xs font-semibold text-primary-600 hover:text-primary-700 flex items-center gap-1">
            View all
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
        <div class="divide-y divide-gray-50">
          <% if (upcoming && upcoming.length > 0) { %>
            <% upcoming.forEach(b => { %>
            <a href="/dashboard/bookings/<%= b.id %>"
              class="flex items-center justify-between px-6 py-3.5 hover:bg-gray-50 transition group">
              <!-- Avatar + name -->
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-9 h-9 rounded-full bg-primary-100 flex items-center justify-center text-primary-700 font-bold text-sm flex-shrink-0">
                  <%= b.customerName ? b.customerName.charAt(0).toUpperCase() : '?' %>
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-sm text-gray-900 truncate"><%= b.customerName %></p>
                  <p class="text-xs text-gray-400 truncate">
                    <%= b.service.name %><% if (b.staff) { %> · <%= b.staff.name %><% } %>
                  </p>
                </div>
              </div>
              <!-- Date + time + badge -->
              <div class="flex items-center gap-3 flex-shrink-0 ml-4">
                <div class="text-right">
                  <p class="text-xs font-semibold text-gray-700"><%= formatDate12(b.startTime) %></p>
                  <p class="text-xs text-gray-400"><%= formatTime12(b.startTime) %></p>
                </div>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-primary-500 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </div>
            </a>
            <% }) %>
          <% } else { %>
            <div class="px-6 py-12 text-center">
              <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <p class="text-sm text-gray-400 font-medium">No upcoming bookings</p>
              <p class="text-xs text-gray-300 mt-1">Share your booking link to get started</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right sidebar: Business Info + Settings shortcut -->
      <div class="space-y-4">

        <!-- Business card -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
          <div class="flex items-start gap-3 mb-4">
            <div class="w-12 h-12 rounded-xl bg-primary-600 flex items-center justify-center text-white font-bold text-lg flex-shrink-0">
              <%= tenant.name ? tenant.name.charAt(0).toUpperCase() : 'B' %>
            </div>
            <div class="min-w-0">
              <h3 class="font-semibold text-gray-900 truncate"><%= tenant.name %></h3>
              <p class="text-xs text-gray-400 mt-0.5 capitalize"><%= tenant.category ? tenant.category.replace(/_/g,' ').toLowerCase() : 'Business' %></p>
              <% if (tenant.phone) { %>
              <p class="text-xs text-gray-400 mt-0.5"><%= tenant.phone %></p>
              <% } %>
            </div>
          </div>

          <!-- Public link full copy box -->
          <div class="bg-gray-50 rounded-xl border border-gray-200 p-3 mb-3">
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-xs font-semibold text-gray-700 flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                Booking Page URL
              </span>
              <span class="text-[10px] font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">Active</span>
            </div>
            <div class="flex items-center gap-2 bg-white rounded-lg border border-gray-200 p-1.5">
              <input id="pub-link" readonly
                value="<%= typeof reqProtocol !== 'undefined' ? reqProtocol : 'http' %>://<%= typeof reqHost !== 'undefined' ? reqHost : 'localhost:3000' %>/business/<%= tenant.slug %>"
                class="text-xs text-gray-700 bg-transparent flex-1 outline-none truncate select-all cursor-pointer font-medium pl-1"
                onclick="this.select()">
              <button onclick="copySidebarLink(this)"
                class="flex-shrink-0 px-3 py-1 bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold rounded-md shadow-sm transition whitespace-nowrap">
                Copy
              </button>
            </div>
          </div>

          <a href="/business/<%= tenant.slug %>" target="_blank"
            class="flex items-center justify-center gap-1.5 w-full py-2 border border-primary-200 bg-primary-50/50 hover:bg-primary-50 text-primary-700 text-xs sm:text-sm font-semibold rounded-lg transition shadow-xs">
            <span>Preview Booking Page</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>

      </div>
    </div><!-- /main grid -->
  </div><!-- /container -->
</div>

<script>
function getFullBookingUrl() {
  var input = document.getElementById('pub-link');
  if (input && input.value) return input.value;
  return window.location.origin + '/business/<%= tenant.slug %>';
}

function copySidebarLink(btn) {
  var url = getFullBookingUrl();
  navigator.clipboard.writeText(url).then(function() {
    var orig = btn.innerHTML;
    btn.innerHTML = '✓ Copied!';
    btn.classList.remove('bg-primary-600', 'hover:bg-primary-700');
    btn.classList.add('bg-emerald-600', 'hover:bg-emerald-700');
    setTimeout(function() {
      btn.innerHTML = orig;
      btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
      btn.classList.add('bg-primary-600', 'hover:bg-primary-700');
    }, 2000);
  }).catch(function() {
    var input = document.getElementById('pub-link');
    if (input) { input.select(); document.execCommand('copy'); }
  });
}
</script>
