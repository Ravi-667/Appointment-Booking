<!-- Dashboard home with stats -->
<div class="max-w-7xl mx-auto px-4 py-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
      <p class="text-gray-500 mt-1"><%= tenant.name %></p>
    </div>
    <div class="mt-3 sm:mt-0 flex items-center space-x-2">
      <label class="text-sm text-gray-500">Period:</label>
      <select id="period-select" onchange="window.location.href='/dashboard?period='+this.value"
        class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm bg-white">
        <option value="7d" <%= stats.period === '7d' ? 'selected' : '' %>>7 Days</option>
        <option value="30d" <%= stats.period === '30d' ? 'selected' : '' %>>30 Days</option>
        <option value="90d" <%= stats.period === '90d' ? 'selected' : '' %>>90 Days</option>
      </select>
    </div>
  </div>

  <!-- Stat cards -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
      <p class="text-sm text-gray-500">Total Bookings</p>
      <p class="text-2xl font-bold text-gray-900 mt-1"><%= stats.total %></p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
      <p class="text-sm text-gray-500">Confirmed</p>
      <p class="text-2xl font-bold text-green-600 mt-1"><%= stats.confirmed %></p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
      <p class="text-sm text-gray-500">Cancelled</p>
      <p class="text-2xl font-bold text-red-600 mt-1"><%= stats.cancelled %></p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
      <p class="text-sm text-gray-500">Cancel Rate</p>
      <p class="text-2xl font-bold text-orange-600 mt-1"><%= stats.cancellationRate %>%</p>
    </div>
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-5">
      <p class="text-sm text-gray-500">Revenue</p>
      <p class="text-2xl font-bold text-primary-600 mt-1">₹<%= Number(stats.revenue).toLocaleString() %></p>
    </div>
  </div>

  <div class="grid lg:grid-cols-2 gap-6">
    <!-- Upcoming bookings -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <div class="flex justify-between items-center mb-4">
        <h2 class="text-lg font-semibold text-gray-900">Upcoming Bookings</h2>
        <a href="/dashboard/bookings" class="text-sm text-primary-600 hover:text-primary-700">View all →</a>
      </div>
      <% if (upcoming && upcoming.length > 0) { %>
        <div class="space-y-3">
          <% upcoming.forEach(b => { %>
          <a href="/dashboard/bookings/<%= b.id %>" class="flex items-center justify-between p-3 rounded-lg hover:bg-gray-50 transition">
            <div>
              <p class="font-medium text-gray-900"><%= b.customerName %></p>
              <p class="text-sm text-gray-500"><%= b.service.name %> <% if (b.staff) { %>with <%= b.staff.name %><% } %></p>
            </div>
            <div class="flex items-center space-x-3 text-right text-sm">
              <div>
                <p class="font-medium text-gray-900"><%= new Date(b.startTime).toLocaleDateString('en-IN', { month:'short', day:'numeric' }) %></p>
                <p class="text-gray-500"><%= new Date(b.startTime).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12:true }) %></p>
              </div>
              <span class="text-primary-600 text-xs font-semibold px-2.5 py-1 bg-primary-50 rounded-lg group-hover:bg-primary-100 transition">View &rarr;</span>
            </div>
          </a>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-gray-400 text-center py-8">No upcoming bookings</p>
      <% } %>
    </div>

    <!-- Quick actions -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Actions</h2>
      <div class="grid grid-cols-2 gap-3">
        <a href="/dashboard/services" class="flex flex-col items-center p-4 border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-sm transition">
          <span class="text-2xl mb-2">🛠️</span><span class="text-sm font-medium text-gray-700">Manage Services</span>
        </a>
        <a href="/dashboard/staff" class="flex flex-col items-center p-4 border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-sm transition">
          <span class="text-2xl mb-2">👥</span><span class="text-sm font-medium text-gray-700">Manage Staff</span>
        </a>
        <a href="/dashboard/calendar" class="flex flex-col items-center p-4 border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-sm transition">
          <span class="text-2xl mb-2">📅</span><span class="text-sm font-medium text-gray-700">View Calendar</span>
        </a>
        <a href="/dashboard/settings" class="flex flex-col items-center p-4 border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-sm transition">
          <span class="text-2xl mb-2">⚙️</span><span class="text-sm font-medium text-gray-700">Settings</span>
        </a>
      </div>
      <div class="mt-4 p-3 bg-primary-50 rounded-lg">
        <p class="text-sm text-primary-800">📎 <strong>Public booking link:</strong></p>
        <code class="text-xs text-primary-600 break-all"><%= typeof reqProtocol !== 'undefined' ? reqProtocol : 'http' %>://<%= typeof reqHost !== 'undefined' ? reqHost : 'localhost:3000' %>/business/<%= tenant.slug %></code>
      </div>
    </div>
  </div>
</div>
