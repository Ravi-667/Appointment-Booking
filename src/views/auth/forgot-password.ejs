<div class="min-h-[80vh] flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Forgot password?</h1>
        <p class="text-gray-500 mt-1">Enter your email and we'll send a reset link</p>
      </div>
      <form action="/forgot-password" method="POST" class="space-y-5">
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
          <input type="email" id="email" name="email" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition"
            placeholder="you@example.com">
        </div>
        <button type="submit"
          class="w-full py-2.5 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 focus:ring-4 focus:ring-primary-200 transition">
          Send Reset Link
        </button>
      </form>
      <p class="text-center text-sm text-gray-500 mt-6">
        <a href="/login" class="text-primary-600 hover:text-primary-700 font-medium">&larr; Back to login</a>
      </p>
    </div>
  </div>
</div>
