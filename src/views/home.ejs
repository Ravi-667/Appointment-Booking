<!-- Home page -->
<section class="bg-gradient-to-br from-primary-600 to-primary-800 text-white">
  <div class="max-w-7xl mx-auto px-4 py-20 sm:py-28">
    <div class="max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold leading-tight">Book Appointments<br>In Seconds</h1>
      <p class="mt-4 text-lg text-primary-100">A complete appointment booking platform for salons, clinics, and service businesses. Set up your business, manage staff, and let customers book online.</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#featured-salons" class="px-6 py-3 bg-white text-primary-700 font-semibold rounded-lg shadow hover:bg-gray-50 transition">Book an Appointment</a>
        <a href="/register" class="px-6 py-3 bg-primary-700 text-white font-semibold rounded-lg border border-primary-500 hover:bg-primary-600 transition">Register Your Business</a>
        <a href="/lookup" class="px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition">Track My Booking</a>
      </div>
    </div>
  </div>
</section>

<!-- Featured Businesses for Customers to Book -->
<% if (typeof tenants !== 'undefined' && tenants && tenants.length > 0) { %>
<section id="featured-salons" class="max-w-7xl mx-auto px-4 py-14">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <span class="text-xs uppercase font-bold tracking-wider text-primary-600 bg-primary-50 px-3 py-1 rounded-full">Customer Booking</span>
    <h2 class="text-3xl font-extrabold text-gray-900 mt-2">Book an Appointment Online</h2>
    <p class="text-gray-600 mt-2">Select a business below to browse services, check real-time availability, and reserve your slot instantly.</p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-6">
    <% tenants.forEach(t => { 
        const categoryColors = {
          'Salon & Spa': 'bg-pink-50 text-pink-700 border-pink-200',
          'Dental & Healthcare': 'bg-cyan-50 text-cyan-700 border-cyan-200',
          'Physiotherapy & Fitness': 'bg-amber-50 text-amber-700 border-amber-200',
          "Men's Salon & Grooming": 'bg-purple-50 text-purple-700 border-purple-200'
        };
        const badgeColor = categoryColors[t.category] || 'bg-blue-50 text-blue-700 border-blue-200';
    %>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-200 hover:border-primary-400 hover:shadow-lg transition duration-200 overflow-hidden flex flex-col justify-between group">
        <div class="p-6">
          <div class="flex items-center justify-between mb-3">
            <span class="inline-block px-2.5 py-0.5 text-xs font-semibold rounded-full border <%= badgeColor %>">
              <%= t.category || 'Service Business' %>
            </span>
            <span class="inline-flex items-center text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span> Open
            </span>
          </div>

          <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary-600 transition"><%= t.name %></h3>
          <p class="text-xs text-gray-500 font-medium mt-1.5 flex items-start">
            <span class="mr-1">📍</span><span><%= t.address || 'Local Studio' %></span>
          </p>

          <div class="mt-4 pt-4 border-t border-gray-100">
            <p class="text-xs uppercase font-semibold tracking-wider text-gray-400 mb-2">Available Services</p>
            <div class="flex flex-wrap gap-1.5">
              <% if (t.services && t.services.length) { %>
                <% t.services.slice(0, 3).forEach(s => { %>
                  <span class="inline-block px-2 py-1 bg-gray-100 text-gray-700 rounded-md text-xs font-medium">
                    <%= s.name.length > 24 ? s.name.slice(0, 22) + '...' : s.name %>
                  </span>
                <% }) %>
                <% if (t.services.length > 3) { %>
                  <span class="inline-block px-2 py-1 bg-gray-50 text-gray-400 rounded-md text-xs font-medium">
                    +<%= t.services.length - 3 %> more
                  </span>
                <% } %>
              <% } else { %>
                <span class="text-xs text-gray-400">Services available online</span>
              <% } %>
            </div>
          </div>

          <% if (t.phone) { %>
            <p class="text-xs text-gray-500 mt-4 flex items-center">
              <span class="mr-1">📞</span><%= t.phone %>
            </p>
          <% } %>
        </div>

        <div class="p-6 pt-0">
          <a href="/business/<%= t.slug %>" class="w-full inline-flex items-center justify-center px-4 py-2.5 bg-primary-600 hover:bg-primary-700 text-white font-medium text-sm rounded-xl transition shadow-sm group-hover:shadow">
            <span>View Services &amp; Book</span>
            <svg class="w-4 h-4 ml-1.5 group-hover:translate-x-0.5 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<section class="max-w-7xl mx-auto px-4 py-16">
  <h2 class="text-2xl font-bold text-gray-900 text-center mb-12">How It Works</h2>
  <div class="grid md:grid-cols-3 gap-8">
    <div class="text-center p-6">
      <div class="w-14 h-14 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">1</div>
      <h3 class="font-semibold text-lg text-gray-900">Register Your Business</h3>
      <p class="mt-2 text-gray-600">Create your account, set up services, staff, and business hours in minutes.</p>
    </div>
    <div class="text-center p-6">
      <div class="w-14 h-14 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">2</div>
      <h3 class="font-semibold text-lg text-gray-900">Share Your Booking Page</h3>
      <p class="mt-2 text-gray-600">Get a public URL for your business. Customers can browse services and pick time slots.</p>
    </div>
    <div class="text-center p-6">
      <div class="w-14 h-14 bg-primary-100 text-primary-600 rounded-full flex items-center justify-center mx-auto mb-4 text-xl font-bold">3</div>
      <h3 class="font-semibold text-lg text-gray-900">Manage & Grow</h3>
      <p class="mt-2 text-gray-600">Track bookings, view analytics, get email notifications — all from your dashboard.</p>
    </div>
  </div>
</section>

<section class="bg-white border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 py-16">
    <h2 class="text-2xl font-bold text-gray-900 text-center mb-12">Features</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% const features = [
        { icon: '📅', title: 'Smart Scheduling', desc: 'Timezone-aware slots with buffer times and lead time controls.' },
        { icon: '🔒', title: 'Slot Locking', desc: 'Redis-backed holds prevent double bookings in real-time.' },
        { icon: '💳', title: 'Razorpay Payments', desc: 'Collect deposits online with automatic webhook confirmation.' },
        { icon: '📧', title: 'Email Notifications', desc: 'Automatic confirmation and cancellation emails.' },
        { icon: '👥', title: 'Staff Management', desc: 'Assign staff to services with individual schedule overrides.' },
        { icon: '📊', title: 'Analytics Dashboard', desc: 'Revenue, cancellation rates, and booking stats at a glance.' },
        { icon: '🏢', title: 'Multi-Tenant', desc: 'Each business gets its own isolated space and settings.' },
        { icon: '⚡', title: 'Real-Time Updates', desc: 'WebSocket-powered live booking notifications.' }
      ] %>
      <% features.forEach(f => { %>
      <div class="p-5 rounded-xl border border-gray-200 hover:shadow-md transition">
        <div class="text-2xl mb-2"><%= f.icon %></div>
        <h3 class="font-semibold text-gray-900"><%= f.title %></h3>
        <p class="text-sm text-gray-600 mt-1"><%= f.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>
