<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — BookingApp' : 'BookingApp' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: { 50:'#eff6ff',100:'#dbeafe',200:'#bfdbfe',300:'#93c5fd',400:'#60a5fa',500:'#3b82f6',600:'#2563eb',700:'#1d4ed8',800:'#1e40af',900:'#1e3a8a' },
            accent: { 50:'#f0fdf4',100:'#dcfce7',500:'#22c55e',600:'#16a34a',700:'#15803d' }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css">
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<% if (typeof fullPage !== 'undefined' && fullPage) { %>
<body class="bg-gray-50">
  <%- include('partials/flash') %>
  <%- body %>
  <script src="/js/app.js"></script>
  <%- typeof script !== 'undefined' ? script : '' %>
</body>
<% } else { %>
<body class="bg-gray-50 min-h-screen flex flex-col">
  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>
  <main class="flex-1">
    <%- body %>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/app.js"></script>
  <%- typeof script !== 'undefined' ? script : '' %>
</body>
<% } %>
</html>
