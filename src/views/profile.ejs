<!-- ═══════════════════════════════════════════════════════
     Profile Page — Business Owner & Customer
════════════════════════════════════════════════════════ -->
<div class="max-w-3xl mx-auto px-4 py-10">

  <!-- Page header -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">My Profile</h1>
    <p class="text-sm text-gray-500 mt-1">Manage your personal info, security, and preferences</p>
  </div>

  <!-- ── Avatar + name hero card ─────────────────────────── -->
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 mb-6 flex items-center gap-5">
    <div class="relative">
      <% if (profileUser.avatarUrl) { %>
        <img src="<%= profileUser.avatarUrl %>" alt="<%= profileUser.name %>"
          class="w-20 h-20 rounded-full object-cover border-4 border-primary-100 shadow">
      <% } else { %>
        <div class="w-20 h-20 rounded-full bg-primary-600 flex items-center justify-center text-white text-3xl font-bold border-4 border-primary-100 shadow">
          <%= profileUser.name ? profileUser.name.charAt(0).toUpperCase() : '?' %>
        </div>
      <% } %>
      <span class="absolute bottom-0 right-0 w-5 h-5 bg-green-400 border-2 border-white rounded-full"></span>
    </div>
    <div>
      <h2 class="text-xl font-bold text-gray-900"><%= profileUser.name %></h2>
      <p class="text-sm text-gray-500"><%= profileUser.email %></p>
      <span class="inline-flex items-center mt-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold
        <%= profileUser.role === 'BUSINESS_OWNER' ? 'bg-primary-100 text-primary-700' : 'bg-green-100 text-green-700' %>">
        <%= profileUser.role === 'BUSINESS_OWNER' ? '🏢 Business Owner' : '👤 Customer' %>
      </span>
    </div>
    <div class="ml-auto text-right hidden sm:block">
      <p class="text-xs text-gray-400">Member since</p>
      <p class="text-sm font-medium text-gray-600"><%= new Date(profileUser.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></p>
    </div>
  </div>

  <!-- ── Sections grid ───────────────────────────────────── -->
  <div class="space-y-5">

    <!-- 1. Personal Information -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          <h3 class="font-semibold text-gray-900">Personal Information</h3>
        </div>
      </div>
      <form action="/profile/update" method="POST" class="px-6 py-5 space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
            <input type="text" name="name" required minlength="2" maxlength="100"
              value="<%= profileUser.name %>"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm transition">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
            <input type="email" name="email" required
              value="<%= profileUser.email %>"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm transition">
          </div>
        </div>
        <div class="flex justify-end pt-1">
          <button type="submit"
            class="px-5 py-2.5 bg-primary-600 text-white text-sm font-semibold rounded-lg hover:bg-primary-700 focus:ring-4 focus:ring-primary-200 transition">
            Save Changes
          </button>
        </div>
      </form>
    </div>

    <!-- 2. Change Password -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <h3 class="font-semibold text-gray-900">Change Password</h3>
      </div>
      <% if (!profileUser.hasPassword) { %>
        <div class="px-6 py-5">
          <div class="flex items-start gap-3 p-4 bg-blue-50 rounded-lg border border-blue-100">
            <svg class="w-5 h-5 text-blue-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div>
              <p class="text-sm font-semibold text-blue-800">Google account</p>
              <p class="text-xs text-blue-600 mt-0.5">Your account uses Google sign-in. You don't have a local password to change.</p>
            </div>
          </div>
        </div>
      <% } else { %>
      <form action="/profile/change-password" method="POST" class="px-6 py-5 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
          <div class="relative">
            <input type="password" id="cur-pass" name="currentPassword" required
              class="w-full px-4 py-2.5 pr-11 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm transition"
              placeholder="Enter current password">
            <button type="button" onclick="togglePwd('cur-pass',this)" tabindex="-1"
              class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600">
              <svg id="eye-on-cur-pass" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              <svg id="eye-off-cur-pass" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
            </button>
          </div>
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
            <div class="relative">
              <input type="password" id="new-pass" name="newPassword" required minlength="8"
                class="w-full px-4 py-2.5 pr-11 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm transition"
                placeholder="Min 8 characters">
              <button type="button" onclick="togglePwd('new-pass',this)" tabindex="-1"
                class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600">
                <svg id="eye-on-new-pass" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg id="eye-off-new-pass" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
              </button>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
            <div class="relative">
              <input type="password" id="conf-pass" name="confirmPassword" required minlength="8"
                class="w-full px-4 py-2.5 pr-11 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none text-sm transition"
                placeholder="Repeat new password">
              <button type="button" onclick="togglePwd('conf-pass',this)" tabindex="-1"
                class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-gray-600">
                <svg id="eye-on-conf-pass" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <svg id="eye-off-conf-pass" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
              </button>
            </div>
          </div>
        </div>
        <p id="pass-match-err" class="text-xs text-red-500 hidden">Passwords do not match</p>
        <div class="flex justify-end pt-1">
          <button type="submit" id="change-pass-btn"
            class="px-5 py-2.5 bg-orange-500 text-white text-sm font-semibold rounded-lg hover:bg-orange-600 focus:ring-4 focus:ring-orange-200 transition">
            Update Password
          </button>
        </div>
      </form>
      <% } %>
    </div>

    <!-- 3. Account & Danger Zone -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <h3 class="font-semibold text-gray-900">Account</h3>
      </div>
      <div class="px-6 py-5 space-y-3">
        <!-- Account info rows -->
        <div class="flex items-center justify-between py-2 border-b border-gray-50">
          <div>
            <p class="text-sm font-medium text-gray-700">Account type</p>
            <p class="text-xs text-gray-400">Your role in BookingApp</p>
          </div>
          <span class="text-sm font-semibold text-gray-600"><%= profileUser.role === 'BUSINESS_OWNER' ? 'Business Owner' : 'Customer' %></span>
        </div>
        <div class="flex items-center justify-between py-2 border-b border-gray-50">
          <div>
            <p class="text-sm font-medium text-gray-700">Sign-in method</p>
            <p class="text-xs text-gray-400">How you log in</p>
          </div>
          <span class="text-sm font-semibold text-gray-600"><%= profileUser.hasPassword ? (profileUser.hasGoogleId ? 'Email + Google' : 'Email & Password') : 'Google' %></span>
        </div>
        <div class="flex items-center justify-between py-2">
          <div>
            <p class="text-sm font-medium text-gray-700">Account status</p>
            <p class="text-xs text-gray-400">Current account state</p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-green-600">
            <span class="w-2 h-2 bg-green-500 rounded-full"></span> Active
          </span>
        </div>

        <!-- Sign out -->
        <div class="pt-3 flex flex-col sm:flex-row gap-3 border-t border-gray-100">
          <a href="/logout"
            class="flex items-center justify-center gap-2 px-5 py-2.5 border border-gray-300 text-gray-700 text-sm font-semibold rounded-lg hover:bg-gray-50 transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1"/></svg>
            Sign out
          </a>
        </div>
      </div>
    </div>

  </div><!-- /sections -->
</div>

<script>
function togglePwd(id, btn) {
  var input = document.getElementById(id);
  var on = document.getElementById('eye-on-' + id);
  var off = document.getElementById('eye-off-' + id);
  if (input.type === 'password') {
    input.type = 'text'; on.classList.add('hidden'); off.classList.remove('hidden');
  } else {
    input.type = 'password'; on.classList.remove('hidden'); off.classList.add('hidden');
  }
}

// Confirm password match check
(function() {
  var np = document.getElementById('new-pass');
  var cp = document.getElementById('conf-pass');
  var err = document.getElementById('pass-match-err');
  var btn = document.getElementById('change-pass-btn');
  if (!np || !cp) return;
  function check() {
    var mismatch = cp.value && np.value !== cp.value;
    err.classList.toggle('hidden', !mismatch);
    btn.disabled = mismatch;
  }
  np.addEventListener('input', check);
  cp.addEventListener('input', check);
})();
</script>
