<!-- Multi-step booking flow -->
<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="bg-white rounded-2xl shadow-lg p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-1">Book at <span class="text-primary-600"><%= tenant.name %></span></h1>
    <p class="text-gray-500 mb-6"><%= service.name %> — <%= service.durationMinutes %> min — ₹<%= Number(service.price).toLocaleString() %></p>

    <!-- Step indicators -->
    <div class="flex items-center mb-8">
      <div class="step-indicator active flex items-center" id="step-ind-1">
        <div class="w-8 h-8 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold">1</div>
        <span class="ml-2 text-sm font-medium text-primary-700">Date & Time</span>
      </div>
      <div class="flex-1 h-0.5 bg-gray-200 mx-3"></div>
      <div class="step-indicator flex items-center" id="step-ind-2">
        <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-bold">2</div>
        <span class="ml-2 text-sm font-medium text-gray-500">Your Details</span>
      </div>
      <div class="flex-1 h-0.5 bg-gray-200 mx-3"></div>
      <div class="step-indicator flex items-center" id="step-ind-3">
        <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-bold">3</div>
        <span class="ml-2 text-sm font-medium text-gray-500">Confirm</span>
      </div>
    </div>

    <!-- Step 1: Date & Slot -->
    <div id="step-1">
      <label class="block text-sm font-medium text-gray-700 mb-2">Select Date</label>
      <input type="date" id="booking-date"
        class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none mb-4"
        value="<%= new Date().toISOString().split('T')[0] %>"
        min="<%= new Date().toISOString().split('T')[0] %>">
      <div id="slots-container" class="mt-2">
        <p class="text-gray-400 text-sm">Pick a date to see available time slots.</p>
      </div>
    </div>

    <!-- Step 2: Customer Info -->
    <div id="step-2" class="hidden">
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
          <input type="text" id="cust-name" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
          <input type="email" id="cust-email" required
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
          <input type="tel" id="cust-phone"
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Notes (optional)</label>
          <textarea id="cust-notes" rows="3"
            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none"></textarea>
        </div>
        <div class="flex gap-3">
          <button onclick="goToStep(1)" class="px-4 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">Back</button>
          <button onclick="submitBooking()" id="btn-book"
            class="flex-1 py-2.5 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition">
            Confirm Booking
          </button>
        </div>
      </div>
    </div>

    <!-- Step 3: Confirmation -->
    <div id="step-3" class="hidden text-center py-8">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h2 class="text-xl font-bold text-gray-900">Booking Created!</h2>
      <p class="text-gray-500 mt-2" id="confirm-msg">Your appointment has been booked.</p>
      <div id="confirm-details" class="mt-4 p-4 bg-gray-50 rounded-lg text-left text-sm space-y-1"></div>
      <a href="/business/<%= tenant.slug %>" class="mt-6 inline-block px-6 py-2.5 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 transition">Book Another</a>
    </div>
  </div>
</div>

<script>
  const TENANT_ID = '<%= tenant.id %>';
  const SERVICE_ID = '<%= service.id %>';
  const TENANT_SLUG = '<%= tenant.slug %>';
  let selectedSlot = null;
  let holdData = null;

  const dateInput = document.getElementById('booking-date');
  dateInput.addEventListener('change', loadSlots);
  dateInput.addEventListener('input', loadSlots);

  // Set default date to today or tomorrow if not set, and load slots immediately
  if (!dateInput.value) {
    const today = new Date().toISOString().split('T')[0];
    dateInput.value = today;
  }
  loadSlots();

  async function loadSlots() {
    const date = dateInput.value;
    if (!date) return;
    const container = document.getElementById('slots-container');
    container.innerHTML = '<p class="text-gray-400 text-sm">Loading available slots...</p>';
    try {
      const res = await fetch('/api/v1/availability?tenantId=' + encodeURIComponent(TENANT_ID) + '&serviceId=' + encodeURIComponent(SERVICE_ID) + '&date=' + encodeURIComponent(date));
      const data = await res.json();
      if (!data.slots || data.slots.length === 0) {
        container.innerHTML = '<p class="text-gray-500 text-sm py-4">No slots available for this date. Try another day.</p>';
        return;
      }
      
      let html = '<p class="text-sm font-medium text-gray-700 mb-3">Available slots (' + data.count + '):</p>';
      html += '<div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">';
      data.slots.forEach(s => {
        const t = new Date(s.startTime);
        const time = t.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
        const staffName = s.staffName || 'Available Specialist';
        html += '<button type="button" onclick="selectSlot(this, \'' + s.startTime + '\', \'' + (s.staffId || '') + '\')" ' +
          'class="slot-btn p-3 border border-gray-200 rounded-xl text-left hover:border-primary-500 hover:bg-primary-50/60 transition shadow-sm bg-white focus:outline-none">' +
          '<div class="font-bold text-gray-900 text-sm">' + time + '</div>' +
          '<div class="text-xs text-gray-500 mt-0.5">' + staffName + '</div>' +
          '</button>';
      });
      html += '</div>';
      container.innerHTML = html;
    } catch (err) {
      container.innerHTML = '<p class="text-red-500 text-sm">Error loading slots. Please try again.</p>';
    }
  }

  function selectSlot(el, startTime, staffId) {
    document.querySelectorAll('.slot-btn').forEach(b => {
      b.classList.remove('border-primary-600', 'bg-primary-50', 'ring-2', 'ring-primary-300');
    });
    el.classList.add('border-primary-600', 'bg-primary-50', 'ring-2', 'ring-primary-300');
    selectedSlot = { startTime, staffId };
    setTimeout(() => goToStep(2), 250);
  }

  function goToStep(n) {
    [1, 2, 3].forEach(i => {
      const stepEl = document.getElementById('step-' + i);
      if (stepEl) stepEl.classList.toggle('hidden', i !== n);
      const ind = document.getElementById('step-ind-' + i);
      if (ind) {
        const circle = ind.querySelector('div');
        const text = ind.querySelector('span');
        if (i <= n) {
          circle.className = 'w-8 h-8 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold shadow-sm';
          text.className = 'ml-2 text-sm font-semibold text-primary-700';
        } else {
          circle.className = 'w-8 h-8 rounded-full bg-gray-200 text-gray-500 flex items-center justify-center text-sm font-bold';
          text.className = 'ml-2 text-sm font-medium text-gray-500';
        }
      }
    });
  }

  async function submitBooking() {
    if (!selectedSlot) { alert('Please select a time slot first.'); return goToStep(1); }
    const name = document.getElementById('cust-name').value.trim();
    const email = document.getElementById('cust-email').value.trim();
    if (!name || !email) { alert('Name and email are required.'); return; }
    const btn = document.getElementById('btn-book');
    btn.disabled = true;
    btn.textContent = 'Securing Booking...';
    try {
      // Step A: Hold the slot in Redis
      const holdRes = await fetch('/api/v1/bookings/hold', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tenantId: TENANT_ID,
          serviceId: SERVICE_ID,
          staffId: selectedSlot.staffId || undefined,
          startTime: selectedSlot.startTime,
          customerName: name,
          customerEmail: email,
          customerPhone: document.getElementById('cust-phone').value || undefined,
        }),
      });
      if (!holdRes.ok) {
        const e = await holdRes.json();
        throw new Error(e.message || 'Slot hold failed');
      }
      holdData = await holdRes.json();

      // Step B: Commit the booking
      const bookRes = await fetch('/api/v1/bookings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          holdId: holdData.holdId,
          sessionToken: holdData.sessionToken,
          customerName: name,
          customerEmail: email,
          customerPhone: document.getElementById('cust-phone').value || undefined,
          notes: document.getElementById('cust-notes').value || undefined,
        }),
      });
      if (!bookRes.ok) {
        const e = await bookRes.json();
        throw new Error(e.message || 'Booking confirmation failed');
      }
      const booking = await bookRes.json();

      // Step C: Display Confirmation Details
      const startDate = new Date(booking.startTime);
      const timeStr = startDate.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });
      const dateStr = startDate.toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
      document.getElementById('confirm-details').innerHTML =
        '<p><strong>Booking ID:</strong> <code class="bg-gray-100 px-1.5 py-0.5 rounded text-primary-700 font-mono text-xs">' + booking.id + '</code></p>' +
        '<p class="mt-1"><strong>Date:</strong> ' + dateStr + '</p>' +
        '<p class="mt-1"><strong>Time:</strong> ' + timeStr + '</p>' +
        '<p class="mt-1"><strong>Status:</strong> <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800">' + booking.status + '</span></p>';
      goToStep(3);
    } catch (err) {
      alert(err.message || 'Booking failed. Please try again.');
      btn.disabled = false;
      btn.textContent = 'Confirm Booking';
    }
  }
</script>
