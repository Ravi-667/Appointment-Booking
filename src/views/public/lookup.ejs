<!-- Customer booking lookup -->
<div class="max-w-lg mx-auto px-4 py-12">
  <div class="bg-white rounded-2xl shadow-lg p-8">
    <h1 class="text-2xl font-bold text-gray-900 text-center mb-2">Track Your Booking</h1>
    <p class="text-gray-500 text-center mb-6">Enter your booking ID and email to look up your appointment.</p>
    <form id="lookup-form" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Booking ID</label>
        <input type="text" id="lookup-id" required placeholder="e.g. a1b2c3d4-..."
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" id="lookup-email" required placeholder="Your email used during booking"
          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 outline-none">
      </div>
      <button type="submit" class="w-full py-2.5 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition">
        Look Up Booking
      </button>
    </form>
    <div id="lookup-result" class="mt-6 hidden"></div>
  </div>
</div>
<script>
  document.getElementById('lookup-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('lookup-id').value.trim();
    const email = document.getElementById('lookup-email').value.trim();
    const container = document.getElementById('lookup-result');
    container.innerHTML = '<p class="text-gray-400">Searching...</p>';
    container.classList.remove('hidden');
    try {
      const res = await fetch(`/api/v1/bookings/lookup?id=${id}&email=${encodeURIComponent(email)}`);
      if (!res.ok) { const e = await res.json(); throw new Error(e.message); }
      const b = await res.json();
      const start = new Date(b.startTime);
      const statusColors = { CONFIRMED: 'green', PENDING_PAYMENT: 'yellow', CANCELLED: 'red', RESCHEDULED: 'blue' };
      const color = statusColors[b.status] || 'gray';
      container.innerHTML = `
        <div class="p-4 bg-gray-50 rounded-lg space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-gray-500">Status</span><span class="px-2 py-0.5 rounded-full text-xs font-medium bg-${color}-100 text-${color}-800">${b.status}</span></div>
          <div class="flex justify-between"><span class="text-gray-500">Service</span><span class="font-medium">${b.service?.name || '-'}</span></div>
          <div class="flex justify-between"><span class="text-gray-500">Date</span><span class="font-medium">${start.toLocaleDateString('en-IN', { weekday:'short', year:'numeric', month:'short', day:'numeric' })}</span></div>
          <div class="flex justify-between"><span class="text-gray-500">Time</span><span class="font-medium">${start.toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit', hour12:true })}</span></div>
          ${b.staff ? '<div class="flex justify-between"><span class="text-gray-500">Staff</span><span class="font-medium">' + b.staff.name + '</span></div>' : ''}
          <div class="flex justify-between"><span class="text-gray-500">Amount</span><span class="font-medium">₹${Number(b.price).toLocaleString()}</span></div>
        </div>`;
    } catch (err) {
      container.innerHTML = '<p class="text-red-500 text-sm">' + (err.message || 'Booking not found.') + '</p>';
    }
  });
</script>
