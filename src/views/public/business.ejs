<!-- Public business page -->
<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
    <!-- Business header -->
    <div class="bg-gradient-to-r from-primary-600 to-primary-700 px-8 py-10 text-white">
      <h1 class="text-3xl font-bold"><%= tenant.name %></h1>
      <% if (tenant.category) { %>
        <span class="inline-block mt-2 px-3 py-1 bg-white/20 rounded-full text-sm"><%= tenant.category %></span>
      <% } %>
      <% if (tenant.phone) { %>
        <p class="mt-2 text-primary-100">📞 <%= tenant.phone %></p>
      <% } %>
      <% if (tenant.address) { %>
        <p class="mt-1 text-primary-100">📍 <%= tenant.address %></p>
      <% } %>
    </div>

    <!-- Business hours -->
    <div class="px-8 py-6 border-b border-gray-200">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold text-gray-900">Business Hours</h2>
        <span class="text-xs text-gray-500 font-medium">12-Hour AM/PM Schedule</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
        <% const days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']; %>
        <% if (tenant.businessHours) { tenant.businessHours.forEach(h => { %>
          <div class="text-sm p-3 rounded-xl border text-center <%= h.isOpen ? 'bg-emerald-50/60 border-emerald-200 text-emerald-900' : 'bg-gray-50 border-gray-200 text-gray-400' %>">
            <span class="font-bold block text-xs uppercase tracking-wider <%= h.isOpen ? 'text-emerald-800' : 'text-gray-400' %>"><%= days[h.dayOfWeek] %></span>
            <% if (h.isOpen) { %>
              <div class="text-xs font-semibold text-emerald-900 mt-1.5 leading-snug">
                <%= formatTime12(h.openTime) %><br><span class="text-[11px] font-normal text-emerald-700">to</span><br><%= formatTime12(h.closeTime) %>
              </div>
            <% } else { %>
              <div class="text-xs font-medium text-gray-400 mt-3">Closed</div>
            <% } %>
          </div>
        <% }) } %>
      </div>
    </div>

    <!-- Services list -->
    <div class="px-8 py-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Our Services</h2>
      <% if (tenant.services && tenant.services.length > 0) { %>
        <div class="space-y-3">
          <% tenant.services.forEach(service => { %>
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-sm transition">
            <div>
              <h3 class="font-semibold text-gray-900"><%= service.name %></h3>
              <% if (service.description) { %><p class="text-sm text-gray-500 mt-0.5"><%= service.description %></p><% } %>
              <div class="flex items-center space-x-3 mt-1 text-sm text-gray-500">
                <span>⏱ <%= service.durationMinutes %> min</span>
                <% if (service.category) { %><span>📂 <%= service.category.name %></span><% } %>
              </div>
            </div>
            <div class="text-right ml-4">
              <p class="text-lg font-bold text-gray-900">₹<%= Number(service.price).toLocaleString() %></p>
              <% if (Number(service.depositAmount) > 0) { %>
                <p class="text-xs text-gray-500">Deposit: ₹<%= Number(service.depositAmount).toLocaleString() %></p>
              <% } %>
              <a href="/book/<%= tenant.slug %>?serviceId=<%= service.id %>"
                class="mt-2 inline-block px-4 py-1.5 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-700 transition">
                Book Now
              </a>
            </div>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-gray-500 text-center py-8">No services available at this time.</p>
      <% } %>
    </div>
  </div>
</div>
