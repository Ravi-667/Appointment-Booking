<!-- Public business page -->
<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
    <!-- Business header -->
    <div class="bg-gradient-to-r from-primary-600 to-primary-700 px-8 py-10 text-white">
      <h1 class="text-3xl font-bold"><%= tenant.name %></h1>
      <% if (tenant.category) { %>
        <span class="inline-block mt-2 px-3 py-1 bg-white/20 rounded-full text-sm"><%= tenant.category %></span>
      <% } %>
      <% if (tenant.phone) { %>
        <p class="mt-2 text-primary-100">📞 <%= tenant.phone %></p>
      <% } %>
      <% if (tenant.address) { %>
        <p class="mt-1 text-primary-100">📍 <%= tenant.address %></p>
      <% } %>
    </div>

    <!-- Business hours -->
    <div class="px-8 py-6 border-b border-gray-200">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-semibold text-gray-900">Business Hours</h2>
        <span class="text-xs text-gray-500 font-medium">12-Hour AM/PM Schedule</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
        <% const days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat']; %>
        <% if (tenant.businessHours) { tenant.businessHours.forEach(h => { %>
          <div class="text-sm p-3 rounded-xl border text-center <%= h.isOpen ? 'bg-emerald-50/60 border-emerald-200 text-emerald-900' : 'bg-gray-50 border-gray-200 text-gray-400' %>">
            <span class="font-bold block text-xs uppercase tracking-wider <%= h.isOpen ? 'text-emerald-800' : 'text-gray-400' %>"><%= days[h.dayOfWeek] %></span>
            <% if (h.isOpen) { %>
              <div class="text-xs font-semibold text-emerald-900 mt-1.5 leading-snug">
                <%= formatTime12(h.openTime) %><br><span class="text-[11px] font-normal text-emerald-700">to</span><br><%= formatTime12(h.closeTime) %>
              </div>
            <% } else { %>
              <div class="text-xs font-medium text-gray-400 mt-3">Closed</div>
            <% } %>
          </div>
        <% }) } %>
      </div>
    </div>

    <!-- Services list -->
    <div class="px-8 py-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Our Services</h2>
      <% if (tenant.services && tenant.services.length > 0) { %>
        <div class="space-y-3">
          <% tenant.services.forEach(service => { %>
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-xl hover:border-primary-300 hover:shadow-sm transition">
            <div>
              <h3 class="font-semibold text-gray-900"><%= service.name %></h3>
              <% if (service.description) { %><p class="text-sm text-gray-500 mt-0.5"><%= service.description %></p><% } %>
              <div class="flex items-center space-x-3 mt-1 text-sm text-gray-500">
                <span>⏱ <%= service.durationMinutes %> min</span>
                <% if (service.category) { %><span>📂 <%= service.category.name %></span><% } %>
              </div>
            </div>
            <div class="text-right ml-4">
              <p class="text-lg font-bold text-gray-900">₹<%= Number(service.price).toLocaleString() %></p>
              <a href="/book/<%= tenant.slug %>?serviceId=<%= service.id %>"
                class="mt-2 inline-block px-4 py-1.5 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-700 transition">
                Book Now
              </a>
            </div>
          </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-gray-500 text-center py-8">No services available at this time.</p>
      <% } %>
    </div>

    <!-- Careers / Join Our Team Section -->
    <div class="px-8 py-5 bg-gradient-to-r from-blue-50/70 to-indigo-50/50 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <span class="text-[11px] font-bold text-primary-600 uppercase tracking-wider block">Careers & Opportunities</span>
        <h3 class="text-base font-bold text-gray-900 mt-0.5">Want to work with <%= tenant.name %>?</h3>
        <p class="text-xs text-gray-500 mt-0.5">We are always looking for talented specialists, therapists, and stylists to join our team.</p>
      </div>
      <button type="button" onclick="openApplyStaffModal()"
        class="flex-shrink-0 px-4 py-2.5 bg-white hover:bg-primary-50 text-primary-700 text-xs font-semibold rounded-xl border border-primary-200 shadow-2xs transition flex items-center gap-1.5 cursor-pointer">
        <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
        <span>Apply as Staff</span>
      </button>
    </div>
  </div>
</div>

<!-- Apply as Staff Candidate Modal -->
<div id="apply-staff-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4" style="display: none;">
  <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 w-full max-w-md overflow-hidden animate-fade-in" onclick="event.stopPropagation()">
    <div class="px-6 py-4 bg-primary-600 text-white flex justify-between items-center">
      <div>
        <h3 class="font-bold text-base leading-tight">Apply to Join <%= tenant.name %></h3>
        <p class="text-xs text-primary-100 mt-0.5">Submit your credentials directly to the owner</p>
      </div>
      <button type="button" onclick="closeApplyStaffModal()" class="text-white/80 hover:text-white text-xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <form action="/business/<%= tenant.slug %>/apply-staff" method="POST" class="p-6 space-y-3.5 text-xs">
      <div>
        <label class="block font-semibold text-gray-700 mb-1">Full Name *</label>
        <input type="text" name="applicantName" required placeholder="e.g. Rahul Kapoor"
          value="<%= typeof user !== 'undefined' && user ? user.name : '' %>"
          class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 outline-none">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        <div>
          <label class="block font-semibold text-gray-700 mb-1">Email Address *</label>
          <input type="email" name="email" required placeholder="rahul@example.com"
            value="<%= typeof user !== 'undefined' && user ? user.email : '' %>"
            class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 outline-none">
        </div>
        <div>
          <label class="block font-semibold text-gray-700 mb-1">Phone Number</label>
          <input type="tel" name="phone" placeholder="+91 98765 43210"
            class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 outline-none">
        </div>
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1">Position / Role Applying For *</label>
        <input type="text" name="roleTitle" required placeholder="e.g. Senior Hair Stylist, Therapist, Esthetician"
          class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 outline-none">
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1">Years of Experience & Key Skills</label>
        <input type="text" name="experience" placeholder="e.g. 5+ years in hair spas and precision styling"
          class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 outline-none">
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1">Cover Note / Message to Owner</label>
        <textarea name="coverNote" rows="2" placeholder="Tell the salon owner why you are a great fit..."
          class="w-full px-3.5 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-primary-500 outline-none"></textarea>
      </div>

      <div class="pt-2 flex justify-end gap-2">
        <button type="button" onclick="closeApplyStaffModal()" class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg font-semibold hover:bg-gray-50 transition cursor-pointer">Cancel</button>
        <button type="submit" class="px-5 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-bold shadow-2xs transition cursor-pointer">Submit Application</button>
      </div>
    </form>
  </div>
</div>

<script>
  window.openApplyStaffModal = function() {
    var modal = document.getElementById('apply-staff-modal');
    modal.style.display = 'flex';
  };
  window.closeApplyStaffModal = function() {
    var modal = document.getElementById('apply-staff-modal');
    modal.style.display = 'none';
  };
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeApplyStaffModal();
  });
  document.getElementById('apply-staff-modal')?.addEventListener('click', function(e) {
    if (e.target === this) closeApplyStaffModal();
  });
</script>

<!-- ═══════════════════════════════════════════════════════════
     Floating Global Chat Panel for Visitors & Customers
════════════════════════════════════════════════════════════ -->
<!-- Floating Trigger Button -->
<div class="fixed bottom-6 right-6 z-40">
  <button type="button" id="chat-launcher-btn"
    class="flex items-center gap-2.5 px-4 py-3 sm:px-5 sm:py-3.5 bg-primary-600 hover:bg-primary-700 active:scale-95 text-white font-semibold rounded-full shadow-xl transition-all duration-200 cursor-pointer group">
    <div class="relative">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      <span id="chat-launcher-badge" class="hidden absolute -top-1 -right-1 w-3 h-3 bg-red-500 rounded-full border-2 border-white animate-pulse"></span>
    </div>
    <span class="text-sm tracking-wide">Ask a Question</span>
  </button>
</div>

<!-- Floating Chat Popover Window -->
<div id="chat-widget-window"
  class="hidden fixed bottom-20 right-4 sm:right-6 z-50 w-[92vw] sm:w-[380px] h-[520px] max-h-[80vh] bg-white rounded-2xl shadow-2xl border border-gray-200 flex-col overflow-hidden transition-all duration-300">
  
  <!-- Chat Window Header -->
  <div class="bg-gradient-to-r from-primary-600 to-primary-700 px-5 py-4 text-white flex items-center justify-between shadow-xs">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-full bg-white/20 border border-white/30 flex items-center justify-center font-bold text-sm text-white">
        <%= tenant.name ? tenant.name.charAt(0).toUpperCase() : 'B' %>
      </div>
      <div>
        <h3 class="font-bold text-sm leading-tight text-white"><%= tenant.name %></h3>
        <p class="text-[11px] text-primary-100 flex items-center gap-1.5 mt-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>Usually replies in minutes</span>
        </p>
      </div>
    </div>
    <button type="button" id="chat-close-btn" class="p-1 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition cursor-pointer">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Visitor Identity Card (Shown if unauthenticated) -->
  <div id="visitor-identity-form" class="p-3 bg-primary-50/70 border-b border-primary-100 text-xs space-y-2">
    <div class="flex items-center justify-between text-primary-800 font-semibold">
      <span>Introduce yourself to start chatting:</span>
      <span class="text-[10px] text-gray-400 font-normal">Stored for this chat</span>
    </div>
    <div class="grid grid-cols-2 gap-2">
      <input type="text" id="visitor-name-input" placeholder="Your Name *"
        value="<%= typeof user !== 'undefined' && user ? user.name : '' %>"
        class="px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-primary-500">
      <input type="email" id="visitor-email-input" placeholder="Your Email *"
        value="<%= typeof user !== 'undefined' && user ? user.email : '' %>"
        class="px-2.5 py-1.5 bg-white border border-gray-300 rounded-lg text-xs outline-none focus:ring-1 focus:ring-primary-500">
    </div>
  </div>

  <!-- Messages Scroll Container -->
  <div id="public-chat-messages" class="flex-1 p-4 overflow-y-auto space-y-3 bg-gray-50/60">
    <div class="text-center py-8 text-gray-400 text-xs">
      <svg class="w-8 h-8 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      Have questions about services, packages or appointments? Send a message directly to the owner!
    </div>
  </div>

  <!-- Chat Input Form -->
  <form id="public-chat-form" class="p-3 bg-white border-t border-gray-200 flex items-center gap-2">
    <input type="text" id="public-chat-input" placeholder="Write a message..."
      class="flex-1 px-3.5 py-2 text-xs sm:text-sm bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
      autocomplete="off">
    <button type="submit" id="public-chat-send-btn"
      class="px-3.5 py-2 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white rounded-xl shadow-xs transition flex items-center justify-center cursor-pointer disabled:opacity-50">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
    </button>
  </form>
</div>

<script src="https://cdn.socket.io/4.6.2/socket.io.min.js"></script>
<script>
(function() {
  var tenantId = "<%= tenant.id %>";
  var launcherBtn = document.getElementById("chat-launcher-btn");
  var launcherBadge = document.getElementById("chat-launcher-badge");
  var chatWindow = document.getElementById("chat-widget-window");
  var closeBtn = document.getElementById("chat-close-btn");
  var messagesBox = document.getElementById("public-chat-messages");
  var form = document.getElementById("public-chat-form");
  var input = document.getElementById("public-chat-input");
  var sendBtn = document.getElementById("public-chat-send-btn");
  var nameInput = document.getElementById("visitor-name-input");
  var emailInput = document.getElementById("visitor-email-input");
  var identityCard = document.getElementById("visitor-identity-form");

  var socket = null;
  var currentThreadId = null;

  // Retrieve saved visitor profile if available
  try {
    var savedName = localStorage.getItem("chat_visitor_name");
    var savedEmail = localStorage.getItem("chat_visitor_email");
    if (savedName && !nameInput.value) nameInput.value = savedName;
    if (savedEmail && !emailInput.value) emailInput.value = savedEmail;
  } catch(e){}

  function getSender() {
    var name = nameInput.value.trim();
    var email = emailInput.value.trim();
    return { name: name, email: email };
  }

  function formatTime(iso) {
    try {
      var d = new Date(iso);
      return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    } catch(e){ return ''; }
  }

  function escapeHtml(str) {
    var div = document.createElement("div");
    div.textContent = str || "";
    return div.innerHTML;
  }

  function toggleChat(show) {
    if (show) {
      chatWindow.classList.remove("hidden");
      chatWindow.classList.add("flex");
      launcherBadge.classList.add("hidden");
      var sender = getSender();
      if (sender.email) {
        initChatThread(sender.email);
      }
      setTimeout(function(){ input.focus(); }, 150);
    } else {
      chatWindow.classList.add("hidden");
      chatWindow.classList.remove("flex");
    }
  }

  launcherBtn.addEventListener("click", function() { toggleChat(true); });
  closeBtn.addEventListener("click", function() { toggleChat(false); });

  function renderMessages(messages) {
    if (!messages || messages.length === 0) {
      messagesBox.innerHTML = '<div class="text-center py-8 text-gray-400 text-xs">' +
        'Have questions about services, packages or appointments? Send a message directly to the owner!' +
        '</div>';
      return;
    }

    var html = '';
    messages.forEach(function(m) {
      var isMe = (m.senderType === 'VISITOR' || m.senderType === 'CUSTOMER');
      html += '<div class="flex flex-col ' + (isMe ? 'items-end' : 'items-start') + '">';
      html += '<div class="flex items-center gap-1 mb-1 text-[10px] text-gray-400">';
      html += '<span class="font-semibold text-gray-600">' + (isMe ? 'You' : '<%= tenant.name %>') + '</span>';
      html += '<span>• ' + formatTime(m.createdAt) + '</span>';
      html += '</div>';
      html += '<div class="max-w-[82%] px-3.5 py-2 rounded-2xl text-xs leading-relaxed shadow-xs ' +
        (isMe ? 'bg-primary-600 text-white rounded-tr-xs' : 'bg-white border border-gray-200 text-gray-800 rounded-tl-xs') + '">';
      html += escapeHtml(m.message);
      html += '</div>';
      html += '</div>';
    });

    messagesBox.innerHTML = html;
    messagesBox.scrollTop = messagesBox.scrollHeight;
  }

  async function loadThreadMessages(threadId) {
    try {
      var res = await fetch('/api/v1/chat/messages?tenantId=' + encodeURIComponent(tenantId) + '&threadId=' + encodeURIComponent(threadId));
      if (!res.ok) return;
      var data = await res.json();
      renderMessages(data.messages || []);
    } catch(e){}
  }

  function initChatThread(email) {
    if (!email) return;
    currentThreadId = "inquiry_" + email.toLowerCase().trim();

    try {
      localStorage.setItem("chat_visitor_name", nameInput.value.trim());
      localStorage.setItem("chat_visitor_email", email.toLowerCase().trim());
    } catch(e){}

    loadThreadMessages(currentThreadId);

    if (!socket) {
      try {
        socket = io();
        socket.emit("join:thread", currentThreadId);
        socket.on("chat:message", function(msg) {
          if (msg.threadId === currentThreadId) {
            loadThreadMessages(currentThreadId);
            if (chatWindow.classList.contains("hidden")) {
              launcherBadge.classList.remove("hidden");
            }
          }
        });
      } catch(e){}
    } else {
      socket.emit("join:thread", currentThreadId);
    }
  }

  form.addEventListener("submit", async function(e) {
    e.preventDefault();
    var sender = getSender();
    if (!sender.name) {
      alert("Please enter your name above.");
      nameInput.focus();
      return;
    }
    if (!sender.email || !sender.email.includes("@")) {
      alert("Please enter a valid email address above.");
      emailInput.focus();
      return;
    }

    var text = input.value.trim();
    if (!text) return;

    initChatThread(sender.email);

    sendBtn.disabled = true;
    input.value = '';

    try {
      var res = await fetch("/api/v1/chat/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          tenantId: tenantId,
          visitorEmail: sender.email,
          senderName: sender.name,
          senderEmail: sender.email,
          senderType: "VISITOR",
          message: text
        })
      });

      if (!res.ok) {
        var errD = await res.json();
        throw new Error(errD.message || "Failed to send");
      }

      loadThreadMessages(currentThreadId);
    } catch(err) {
      alert("Error sending message: " + err.message);
    } finally {
      sendBtn.disabled = false;
      input.focus();
    }
  });

  // If already authenticated or remembered, connect thread
  var initialSender = getSender();
  if (initialSender.email) {
    initChatThread(initialSender.email);
  }
})();
</script>
