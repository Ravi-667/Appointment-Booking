<!-- ═══════════════════════════════════════════════════════════
     My Bookings — Multi-Tenant Customer Portal
════════════════════════════════════════════════════════════ -->
<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 min-h-[80vh]">
  
  <!-- Header Bar -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2.5">
        <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span>My Bookings</span>
      </h1>
      <p class="text-sm text-gray-500 mt-1">Manage your appointments, chat with specialists, and track visits across all businesses.</p>
    </div>

    <!-- Right action / auth indicator -->
    <div id="auth-status-container">
      <% if (typeof user !== 'undefined' && user) { %>
        <div class="flex items-center gap-2.5 px-3.5 py-2 bg-white rounded-xl border border-gray-200 shadow-2xs">
          <div class="w-8 h-8 rounded-full bg-primary-100 text-primary-700 font-bold text-xs flex items-center justify-center">
            <%= (user.name ? user.name.charAt(0) : 'U').toUpperCase() %>
          </div>
          <div class="text-xs">
            <span class="font-bold text-gray-800 block leading-tight"><%= user.name %></span>
            <span class="text-gray-400"><%= user.email %></span>
          </div>
        </div>
      <% } else { %>
        <div class="flex items-center gap-2 text-xs">
          <span class="text-gray-500">Have an account?</span>
          <a href="/login?return=/my-bookings" class="px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg shadow-2xs transition">Sign In</a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Guest Email Search Card (Shown when not logged in or switching email) -->
  <div id="email-lookup-card" class="<%= (typeof user !== 'undefined' && user) ? 'hidden' : '' %> mb-8 p-6 bg-gradient-to-br from-primary-50/90 to-blue-50/50 rounded-2xl border border-primary-100 shadow-xs">
    <div class="max-w-xl mx-auto text-center space-y-3">
      <div class="w-12 h-12 rounded-xl bg-white text-primary-600 flex items-center justify-center mx-auto shadow-2xs border border-primary-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-gray-900">Look Up Your Bookings Instantly</h3>
        <p class="text-xs text-gray-600 mt-1">Enter the email you used when booking. No password or booking ID required.</p>
      </div>
      <form id="email-search-form" class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto pt-1">
        <input type="email" id="customer-email-input" required placeholder="Enter your booking email..."
          class="flex-1 px-4 py-2.5 bg-white border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 shadow-2xs transition"
          value="<%= (typeof user !== 'undefined' && user) ? user.email : '' %>">
        <button type="submit" id="btn-search-bookings"
          class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white text-sm font-semibold rounded-xl shadow-xs transition flex items-center justify-center gap-1.5 cursor-pointer">
          <span>Find Bookings</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </button>
      </form>
    </div>
  </div>

  <!-- Live Notifications & Updates Banner -->
  <div id="customer-notif-banner" class="hidden mb-6 p-4 rounded-2xl bg-gradient-to-r from-primary-50 to-blue-50 border border-primary-200 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
    <div class="flex items-start gap-3">
      <div class="w-8 h-8 rounded-full bg-primary-600 text-white flex items-center justify-center flex-shrink-0 font-bold text-xs shadow-2xs">🔔</div>
      <div>
        <h4 id="cust-notif-title" class="font-bold text-gray-900 text-xs">Latest Appointment Update</h4>
        <p id="cust-notif-msg" class="text-gray-600 mt-0.5 leading-relaxed"></p>
      </div>
    </div>
    <div class="flex items-center gap-2 self-end sm:self-center">
      <button type="button" id="cust-notif-action-btn" class="hidden px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg shadow-2xs transition cursor-pointer">
        Reply in Chat 💬
      </button>
      <button type="button" onclick="document.getElementById('customer-notif-banner').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-lg font-bold px-1.5 cursor-pointer" title="Dismiss">&times;</button>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <div class="flex items-center justify-between border-b border-gray-200 mb-6">
    <div class="flex space-x-6 text-sm font-semibold">
      <button type="button" id="tab-upcoming-btn" onclick="switchBookingsTab('UPCOMING')"
        class="pb-3 border-b-2 border-primary-600 text-primary-600 flex items-center gap-2 transition cursor-pointer">
        <span>Upcoming Appointments</span>
        <span id="badge-upcoming-count" class="px-2 py-0.5 rounded-full text-xs bg-primary-100 text-primary-800 font-bold">0</span>
      </button>
      <button type="button" id="tab-past-btn" onclick="switchBookingsTab('PAST')"
        class="pb-3 border-b-2 border-transparent text-gray-500 hover:text-gray-900 flex items-center gap-2 transition cursor-pointer">
        <span>Past & Cancelled</span>
        <span id="badge-past-count" class="px-2 py-0.5 rounded-full text-xs bg-gray-100 text-gray-600 font-bold">0</span>
      </button>
    </div>
    <div id="active-email-pill" class="hidden text-xs text-gray-500">
      Showing bookings for: <span id="current-email-label" class="font-semibold text-gray-700"></span>
      <button type="button" onclick="changeEmailSearch()" class="ml-1 text-primary-600 hover:underline">Change</button>
    </div>
  </div>

  <!-- Loading State -->
  <div id="bookings-loading-state" class="py-16 text-center text-gray-400 text-sm hidden">
    <svg class="w-8 h-8 mx-auto mb-3 text-primary-500 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg>
    Loading your appointments...
  </div>

  <!-- Empty State -->
  <div id="bookings-empty-state" class="hidden py-16 text-center bg-white rounded-2xl border border-gray-200 p-8 shadow-xs">
    <div class="w-16 h-16 rounded-full bg-primary-50 text-primary-600 flex items-center justify-center mx-auto mb-4">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    </div>
    <h3 class="text-lg font-bold text-gray-900" id="empty-state-title">No Upcoming Appointments</h3>
    <p class="text-sm text-gray-500 max-w-sm mx-auto mt-1" id="empty-state-desc">You do not have any scheduled appointments right now. Browse our verified salons and clinics to book your next session!</p>
    <a href="/#featured-salons" class="mt-5 inline-flex items-center gap-1.5 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white font-semibold text-sm rounded-xl shadow-xs transition">
      <span>Browse Businesses</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
    </a>
  </div>

  <!-- Bookings List Cards Container -->
  <div id="bookings-cards-container" class="space-y-4">
    <!-- Dynamically rendered booking cards -->
  </div>

</div>

<!-- ═══════════════════════════════════════════════════════════
     Interactive In-Page Appointment Consultation Chat Modal
════════════════════════════════════════════════════════════ -->
<div id="chat-consultation-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 w-full max-w-lg h-[540px] max-h-[90vh] flex flex-col overflow-hidden animate-fade-in">
    
    <!-- Modal Header -->
    <div class="bg-gradient-to-r from-primary-600 to-primary-700 px-5 py-4 text-white flex items-center justify-between shadow-xs">
      <div class="flex items-center gap-3">
        <div id="modal-chat-avatar" class="w-9 h-9 rounded-full bg-white/20 border border-white/30 flex items-center justify-center font-bold text-sm text-white">
          S
        </div>
        <div>
          <h3 id="modal-chat-title" class="font-bold text-sm text-white leading-tight">Salon Consultation</h3>
          <p id="modal-chat-service" class="text-xs text-primary-100 mt-0.5">Service Consultation</p>
        </div>
      </div>
      <button type="button" onclick="closeChatModal()" class="p-1 rounded-lg text-white/80 hover:text-white hover:bg-white/10 transition cursor-pointer">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Messages Body -->
    <div id="modal-chat-stream" class="flex-1 p-5 overflow-y-auto space-y-3 bg-gray-50/60">
      <div class="text-center py-10 text-gray-400 text-xs">Loading consultation history...</div>
    </div>

    <!-- Message Composer -->
    <form id="modal-chat-form" class="p-3 bg-white border-t border-gray-200 flex items-center gap-2">
      <input type="text" id="modal-chat-input" placeholder="Type a message to the specialist / owner..."
        class="flex-1 px-3.5 py-2 text-xs sm:text-sm bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
        autocomplete="off">
      <button type="submit" id="modal-chat-send-btn"
        class="px-4 py-2 bg-primary-600 hover:bg-primary-700 active:bg-primary-800 text-white text-xs sm:text-sm font-semibold rounded-xl shadow-xs transition flex items-center gap-1 cursor-pointer disabled:opacity-50">
        <span>Send</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
      </button>
    </form>
  </div>
</div>

<script src="https://cdn.socket.io/4.6.2/socket.io.min.js"></script>
<script>
(function() {
  var currentTab = "UPCOMING";
  var bookingsData = { upcoming: [], past: [] };
  var activeChatBooking = null;
  var socket = null;

  var tabUpcomingBtn = document.getElementById("tab-upcoming-btn");
  var tabPastBtn = document.getElementById("tab-past-btn");
  var badgeUpcomingCount = document.getElementById("badge-upcoming-count");
  var badgePastCount = document.getElementById("badge-past-count");
  var emailForm = document.getElementById("email-search-form");
  var emailInput = document.getElementById("customer-email-input");
  var emailLookupCard = document.getElementById("email-lookup-card");
  var activeEmailPill = document.getElementById("active-email-pill");
  var currentEmailLabel = document.getElementById("current-email-label");
  var cardsContainer = document.getElementById("bookings-cards-container");
  var loadingState = document.getElementById("bookings-loading-state");
  var emptyState = document.getElementById("bookings-empty-state");
  var emptyTitle = document.getElementById("empty-state-title");
  var emptyDesc = document.getElementById("empty-state-desc");

  // Modal elements
  var chatModal = document.getElementById("chat-consultation-modal");
  var modalChatStream = document.getElementById("modal-chat-stream");
  var modalChatForm = document.getElementById("modal-chat-form");
  var modalChatInput = document.getElementById("modal-chat-input");
  var modalChatSendBtn = document.getElementById("modal-chat-send-btn");
  var modalChatTitle = document.getElementById("modal-chat-title");
  var modalChatService = document.getElementById("modal-chat-service");
  var modalChatAvatar = document.getElementById("modal-chat-avatar");

  window.switchBookingsTab = function(tab) {
    currentTab = tab;
    if (tab === "UPCOMING") {
      tabUpcomingBtn.className = "pb-3 border-b-2 border-primary-600 text-primary-600 flex items-center gap-2 transition cursor-pointer font-semibold";
      tabPastBtn.className = "pb-3 border-b-2 border-transparent text-gray-500 hover:text-gray-900 flex items-center gap-2 transition cursor-pointer font-semibold";
    } else {
      tabPastBtn.className = "pb-3 border-b-2 border-primary-600 text-primary-600 flex items-center gap-2 transition cursor-pointer font-semibold";
      tabUpcomingBtn.className = "pb-3 border-b-2 border-transparent text-gray-500 hover:text-gray-900 flex items-center gap-2 transition cursor-pointer font-semibold";
    }
    renderBookings();
  };

  window.changeEmailSearch = function() {
    emailLookupCard.classList.remove("hidden");
    emailInput.focus();
    emailInput.select();
  };

  function escapeHtml(str) {
    var div = document.createElement("div");
    div.textContent = str || "";
    return div.innerHTML;
  }

  function formatDateTimeNice(iso) {
    try {
      var d = new Date(iso);
      var dateStr = d.toLocaleDateString("en-IN", { weekday: "short", day: "numeric", month: "short", year: "numeric" });
      var timeStr = d.toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true });
      return { dateStr: dateStr, timeStr: timeStr };
    } catch(e) { return { dateStr: "", timeStr: "" }; }
  }

  function getRelativeBadge(iso) {
    try {
      var start = new Date(iso);
      var now = new Date();
      var diffMs = start.getTime() - now.getTime();
      var diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));

      if (diffMs < 0) return { label: "Past Visit", cls: "bg-gray-100 text-gray-600" };
      if (diffDays === 0) return { label: "Today", cls: "bg-emerald-100 text-emerald-800 animate-pulse font-bold" };
      if (diffDays === 1) return { label: "Tomorrow", cls: "bg-blue-100 text-blue-800 font-bold" };
      return { label: "In " + diffDays + " days", cls: "bg-primary-50 text-primary-700" };
    } catch(e) { return { label: "", cls: "" }; }
  }

  function renderBookings() {
    var list = (currentTab === "UPCOMING") ? bookingsData.upcoming : bookingsData.past;

    badgeUpcomingCount.textContent = bookingsData.upcoming.length;
    badgePastCount.textContent = bookingsData.past.length;

    if (!list || list.length === 0) {
      cardsContainer.innerHTML = "";
      emptyState.classList.remove("hidden");
      if (currentTab === "UPCOMING") {
        emptyTitle.textContent = "No Upcoming Appointments";
        emptyDesc.textContent = "You do not have any scheduled appointments right now. Browse our verified salons and clinics to book your next session!";
      } else {
        emptyTitle.textContent = "No Past Bookings";
        emptyDesc.textContent = "Your completed and past appointment history will appear here.";
      }
      return;
    }

    emptyState.classList.add("hidden");
    var html = "";

    list.forEach(function(b) {
      var dt = formatDateTimeNice(b.startTime);
      var rel = getRelativeBadge(b.startTime);
      var tenant = b.tenant || {};
      var service = b.service || {};
      var staff = b.staff || null;

      var statusColors = {
        CONFIRMED: "bg-emerald-100 text-emerald-800 border-emerald-200",
        PENDING_PAYMENT: "bg-amber-100 text-amber-800 border-amber-200",
        CANCELLED: "bg-red-100 text-red-800 border-red-200",
        RESCHEDULED: "bg-blue-100 text-blue-800 border-blue-200",
        NO_SHOW: "bg-orange-100 text-orange-800 border-orange-200"
      };
      var statusBadgeCls = statusColors[b.status] || "bg-gray-100 text-gray-800 border-gray-200";

      html += '<div class="bg-white rounded-2xl border border-gray-200 shadow-xs hover:shadow-md transition duration-200 overflow-hidden">';
      
      // Top header of card: Tenant identity + status
      html += '<div class="px-6 py-4 bg-gray-50/70 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">';
      html += '<div class="flex items-center gap-3">';
      html += '<div class="w-10 h-10 rounded-xl bg-primary-100 text-primary-700 font-bold text-sm flex items-center justify-center flex-shrink-0">' +
        (tenant.name ? tenant.name.charAt(0).toUpperCase() : 'B') + '</div>';
      html += '<div>';
      html += '<div class="flex items-center gap-2">';
      html += '<a href="/business/' + (tenant.slug || '') + '" class="font-bold text-base text-gray-900 hover:text-primary-600 transition">' + escapeHtml(tenant.name || 'Service Business') + '</a>';
      if (tenant.category) {
        html += '<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-gray-200/70 text-gray-700">' + escapeHtml(tenant.category) + '</span>';
      }
      html += '</div>';
      if (tenant.address) {
        html += '<p class="text-xs text-gray-400 mt-0.5">📍 ' + escapeHtml(tenant.address) + '</p>';
      }
      html += '</div></div>';

      // Status pill + relative tag
      html += '<div class="flex items-center gap-2 self-end sm:self-center">';
      if (rel.label) {
        html += '<span class="px-2.5 py-0.5 rounded-full text-xs font-medium ' + rel.cls + '">' + rel.label + '</span>';
      }
      html += '<span class="px-3 py-1 rounded-full text-xs font-bold border ' + statusBadgeCls + '">' + b.status + '</span>';
      html += '</div>';
      html += '</div>';

      // Middle details grid
      html += '<div class="px-6 py-5 grid sm:grid-cols-3 gap-4 text-sm">';
      
      // Service
      html += '<div>';
      html += '<span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Service</span>';
      html += '<p class="font-bold text-gray-900 mt-1 text-base">' + escapeHtml(service.name || 'Appointment') + '</p>';
      html += '<span class="text-xs text-gray-500 mt-0.5 block">⏱ ' + (service.durationMinutes || 30) + ' Minutes</span>';
      html += '</div>';

      // Date & Time
      html += '<div>';
      html += '<span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Date & Time</span>';
      html += '<p class="font-bold text-gray-900 mt-1">' + dt.dateStr + '</p>';
      html += '<p class="text-xs font-semibold text-primary-700 mt-0.5">🕒 ' + dt.timeStr + '</p>';
      html += '</div>';

      // Specialist & Payment
      html += '<div>';
      html += '<span class="text-xs font-semibold text-gray-400 uppercase tracking-wider block">Specialist & Price</span>';
      html += '<p class="font-medium text-gray-800 mt-1">👤 ' + escapeHtml(staff ? staff.name : 'Dedicated Specialist') + '</p>';
      html += '<p class="text-sm font-bold text-emerald-600 mt-0.5">₹' + Number(b.price || 0).toLocaleString() + ' <span class="text-xs font-normal text-gray-500">(Paid)</span></p>';
      html += '</div>';

      html += '</div>';

      // Footer actions
      html += '<div class="px-6 py-3.5 bg-gray-50/40 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3">';
      
      html += '<div class="text-xs text-gray-500">';
      html += 'Booked by <span class="font-medium text-gray-700">' + escapeHtml(b.customerName) + '</span>';
      html += '</div>';

      html += '<div class="flex items-center gap-2">';
      // Chat button
      html += '<button type="button" onclick="openChatModal(\'' + b.id + '\')" ' +
        'class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-primary-50 hover:bg-primary-100 text-primary-700 font-semibold text-xs rounded-xl border border-primary-200 transition shadow-2xs cursor-pointer">' +
        '<svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>' +
        '<span>Chat with Specialist</span>' +
        '</button>';

      // Cancel button if confirmed and upcoming
      if (currentTab === "UPCOMING" && (b.status === "CONFIRMED" || b.status === "PENDING_PAYMENT")) {
        html += '<button type="button" onclick="cancelCustomerBooking(\'' + b.id + '\')" ' +
          'class="px-3 py-1.5 bg-white hover:bg-red-50 text-red-600 font-semibold text-xs rounded-xl border border-red-200 transition shadow-2xs cursor-pointer">' +
          'Cancel' +
          '</button>';
      }

      // Rebook button
      if (tenant.slug) {
        html += '<a href="/book/' + tenant.slug + (service.id ? '?serviceId=' + service.id : '') + '" ' +
          'class="px-3.5 py-1.5 bg-white hover:bg-gray-50 text-gray-700 font-semibold text-xs rounded-xl border border-gray-200 transition shadow-2xs">' +
          'Book Again' +
          '</a>';
      }

      html += '</div></div>';
      html += '</div>';
    });

    cardsContainer.innerHTML = html;
  }

  async function fetchMyBookings(email) {
    if (!email) return;
    loadingState.classList.remove("hidden");
    cardsContainer.innerHTML = "";
    emptyState.classList.add("hidden");

    try {
      var res = await fetch("/api/v1/bookings/my-bookings?email=" + encodeURIComponent(email));
      if (!res.ok) throw new Error("Could not load bookings");
      var data = await res.json();
      bookingsData.upcoming = data.upcoming || [];
      bookingsData.past = data.past || [];

      try {
        localStorage.setItem("my_bookings_email", email);
      } catch(e){}

      currentEmailLabel.textContent = email;
      activeEmailPill.classList.remove("hidden");
      emailLookupCard.classList.add("hidden");

      // Check for customer alerts & notifications
      fetch("/api/v1/notifications?email=" + encodeURIComponent(email) + "&limit=3")
        .then(function(r){ return r.json(); })
        .then(function(d){
          if (d && d.notifications && d.notifications.length > 0) {
            var latest = d.notifications[0];
            var banner = document.getElementById("customer-notif-banner");
            var title = document.getElementById("cust-notif-title");
            var msg = document.getElementById("cust-notif-msg");
            var actionBtn = document.getElementById("cust-notif-action-btn");
            if (banner && title && msg) {
              title.textContent = latest.title;
              msg.textContent = latest.message;

              var meta = latest.metadata || {};
              var threadId = meta.threadId || (latest.link && latest.link.includes("openChat=") ? new URLSearchParams(latest.link.split("?")[1]).get("openChat") : null);
              var bookingId = meta.bookingId || (threadId && threadId.startsWith("booking_") ? threadId.replace("booking_", "") : threadId);

              if (latest.type === "CHAT_MESSAGE" && bookingId && actionBtn) {
                actionBtn.textContent = "Reply in Chat 💬";
                actionBtn.onclick = function() { window.openChatModal(bookingId); };
                actionBtn.classList.remove("hidden");
              } else if (bookingId && actionBtn) {
                actionBtn.textContent = "View Appointment →";
                actionBtn.onclick = function() {
                  var el = document.getElementById("booking-card-" + bookingId);
                  if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
                };
                actionBtn.classList.remove("hidden");
              } else if (actionBtn) {
                actionBtn.classList.add("hidden");
              }

              banner.classList.remove("hidden");
            }
          }
        }).catch(function(){});

      renderBookings();

      // Check URL query parameters for deep linking
      try {
        var urlParams = new URLSearchParams(window.location.search);
        var autoOpenChatId = urlParams.get("openChat");
        var autoHighlightId = urlParams.get("highlightBooking");
        var requestedTab = urlParams.get("tab");

        if (requestedTab && requestedTab.toLowerCase() === "past") {
          switchBookingsTab("PAST");
        }

        if (autoOpenChatId) {
          var allBookings = bookingsData.upcoming.concat(bookingsData.past);
          var inPast = bookingsData.past.some(function(b){ return b.id === autoOpenChatId; });
          if (inPast) {
            switchBookingsTab("PAST");
          }
          setTimeout(function() {
            window.openChatModal(autoOpenChatId);
          }, 200);
        } else if (autoHighlightId) {
          setTimeout(function() {
            var el = document.getElementById("booking-card-" + autoHighlightId);
            if (el) {
              el.scrollIntoView({ behavior: "smooth", block: "center" });
              el.classList.add("ring-4", "ring-primary-400", "transition-all");
              setTimeout(function(){ el.classList.remove("ring-4", "ring-primary-400"); }, 3000);
            }
          }, 250);
        }
      } catch(e){}
    } catch(err) {
      cardsContainer.innerHTML = '<div class="p-6 text-center text-red-600 bg-red-50 border border-red-200 rounded-xl text-sm font-medium">Failed to load appointments: ' + err.message + '</div>';
    } finally {
      loadingState.classList.add("hidden");
    }
  }

  emailForm.addEventListener("submit", function(e) {
    e.preventDefault();
    var email = emailInput.value.trim();
    if (email) {
      fetchMyBookings(email);
    }
  });

  window.cancelCustomerBooking = async function(bookingId) {
    var email = emailInput.value.trim() || "<%= (typeof user !== 'undefined' && user) ? user.email : '' %>";
    if (!confirm("Are you sure you want to cancel this appointment?")) return;

    try {
      var res = await fetch("/api/v1/bookings/" + bookingId + "/customer-cancel", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email, reason: "Cancelled by customer via My Bookings portal" })
      });
      if (!res.ok) {
        var errD = await res.json();
        throw new Error(errD.message || "Failed to cancel");
      }
      fetchMyBookings(email);
    } catch(err) {
      alert("Could not cancel: " + err.message);
    }
  };

  // ── Modal Chat Handling ─────────────────────────────────────
  window.openChatModal = function(bookingId) {
    var all = bookingsData.upcoming.concat(bookingsData.past);
    var b = all.find(function(item){ return item.id === bookingId; });
    if (!b) {
      b = { id: bookingId, tenant: { name: "Specialist Consultation" }, service: { name: "Appointment Message" } };
    }

    activeChatBooking = b;
    var threadId = "booking_" + b.id;

    modalChatTitle.textContent = (b.tenant ? b.tenant.name : "Salon") + " Consultation";
    modalChatService.textContent = (b.service ? b.service.name : "Appointment");
    modalChatAvatar.textContent = (b.tenant && b.tenant.name ? b.tenant.name.charAt(0) : "S").toUpperCase();

    chatModal.classList.remove("hidden");
    loadModalMessages(threadId);

    // Socket.io connection
    try {
      if (!socket) socket = io();
      socket.emit("join:thread", threadId);
      socket.on("chat:message", function(msg) {
        if (msg.threadId === threadId) {
          loadModalMessages(threadId);
        }
      });
    } catch(e){}

    setTimeout(function(){ modalChatInput.focus(); }, 100);
  };

  window.closeChatModal = function() {
    chatModal.classList.add("hidden");
    activeChatBooking = null;
  };

  async function loadModalMessages(threadId) {
    try {
      var res = await fetch("/api/v1/chat/messages?threadId=" + encodeURIComponent(threadId));
      if (!res.ok) return;
      var data = await res.json();
      var msgs = data.messages || [];

      if (msgs.length === 0) {
        modalChatStream.innerHTML = '<div class="text-center py-10 text-gray-400 text-xs">' +
          '<svg class="w-8 h-8 mx-auto mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>' +
          'No messages yet. Send a message to start communicating with the specialist.' +
          '</div>';
        return;
      }

      var html = "";
      msgs.forEach(function(m) {
        var isMe = (m.senderType === "CUSTOMER" || m.senderType === "VISITOR");
        var timeStr = "";
        try { timeStr = new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); } catch(e){}

        html += '<div class="flex flex-col ' + (isMe ? 'items-end' : 'items-start') + '">';
        html += '<div class="flex items-center gap-1.5 mb-1 text-[10px] text-gray-400">';
        html += '<span class="font-semibold text-gray-700">' + (isMe ? 'You' : (m.senderName || 'Salon Owner')) + '</span>';
        html += '<span>• ' + timeStr + '</span>';
        html += '</div>';
        html += '<div class="max-w-[80%] px-3.5 py-2 rounded-2xl text-xs sm:text-sm leading-relaxed shadow-xs ' +
          (isMe ? 'bg-primary-600 text-white rounded-tr-xs' : 'bg-white border border-gray-200 text-gray-800 rounded-tl-xs') + '">';
        html += escapeHtml(m.message);
        html += '</div>';
        html += '</div>';
      });

      modalChatStream.innerHTML = html;
      modalChatStream.scrollTop = modalChatStream.scrollHeight;
    } catch(e){}
  }

  modalChatForm.addEventListener("submit", async function(e) {
    e.preventDefault();
    if (!activeChatBooking) return;

    var text = modalChatInput.value.trim();
    if (!text) return;

    modalChatSendBtn.disabled = true;
    modalChatInput.value = "";

    try {
      var res = await fetch("/api/v1/chat/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          bookingId: activeChatBooking.id,
          tenantId: activeChatBooking.tenantId,
          senderName: activeChatBooking.customerName,
          senderEmail: activeChatBooking.customerEmail,
          senderType: "CUSTOMER",
          message: text
        })
      });
      if (!res.ok) {
        var errD = await res.json();
        throw new Error(errD.message || "Failed to send");
      }
      loadModalMessages("booking_" + activeChatBooking.id);
    } catch(err) {
      alert("Error sending: " + err.message);
    } finally {
      modalChatSendBtn.disabled = false;
      modalChatInput.focus();
    }
  });

  // Initial Auto-load Priority:
  // 1. Logged in user email
  // 2. URL param ?email=...
  // 3. LocalStorage saved email
  var userEmail = "<%= (typeof user !== 'undefined' && user) ? user.email : '' %>";
  var urlEmail = new URLSearchParams(window.location.search).get("email");
  var savedEmail = "";
  try { savedEmail = localStorage.getItem("my_bookings_email") || ""; } catch(e){}

  var targetEmail = userEmail || urlEmail || savedEmail;
  if (targetEmail) {
    emailInput.value = targetEmail;
    fetchMyBookings(targetEmail);
  }
})();
</script>
