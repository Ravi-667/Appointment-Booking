<!-- ═══════════════════════════════════════════════════════════
     Dedicated Staff Member Portal — Scoped Specialist Workspace
════════════════════════════════════════════════════════════ -->
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

  <!-- ── Top Specialist Banner ─────────────────────────────── -->
  <div class="bg-gradient-to-r from-primary-900 via-primary-800 to-indigo-900 rounded-2xl p-6 sm:p-8 text-white shadow-xl mb-6 relative overflow-hidden">
    <div class="absolute -right-12 -top-12 w-64 h-64 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute right-1/4 -bottom-12 w-48 h-48 bg-primary-400/10 rounded-full blur-xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white/10 border-2 border-white/20 text-white font-extrabold text-2xl sm:text-3xl flex items-center justify-center shadow-inner flex-shrink-0 backdrop-blur-xs">
          <%= (staff.name.charAt(0) || 'S').toUpperCase() %>
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-primary-500/30 text-primary-200 border border-primary-400/30">
              Staff Portal
            </span>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              On Duty
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight"><%= staff.name %></h1>
          <p class="text-sm text-primary-200 mt-0.5 flex flex-wrap items-center gap-2">
            <span><%= staff.roleTitle || 'Specialist' %></span>
            <span>&bull;</span>
            <span class="text-white font-medium"><%= tenant.name %></span>
          </p>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-3 gap-3 sm:gap-4 flex-shrink-0">
        <div class="bg-white/10 backdrop-blur-xs rounded-xl p-3 sm:p-4 border border-white/10 text-center">
          <p class="text-[11px] text-primary-200 uppercase font-semibold tracking-wider">Today</p>
          <p class="text-xl sm:text-2xl font-black mt-0.5"><%= todayBookings.length %></p>
        </div>
        <div class="bg-white/10 backdrop-blur-xs rounded-xl p-3 sm:p-4 border border-white/10 text-center">
          <p class="text-[11px] text-primary-200 uppercase font-semibold tracking-wider">Upcoming</p>
          <p class="text-xl sm:text-2xl font-black mt-0.5"><%= upcomingBookings.length %></p>
        </div>
        <div class="bg-white/10 backdrop-blur-xs rounded-xl p-3 sm:p-4 border border-white/10 text-center">
          <p class="text-[11px] text-primary-200 uppercase font-semibold tracking-wider">Total</p>
          <p class="text-xl sm:text-2xl font-black mt-0.5"><%= totalAssigned %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Staff Tabs Navigation ─────────────────────────────── -->
  <div class="bg-white rounded-2xl shadow-xs border border-gray-200 p-2 mb-6 flex flex-wrap gap-2">
    <button type="button" onclick="switchStaffTab('appointments')" id="tab-nav-appointments"
      class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 cursor-pointer bg-primary-600 text-white shadow-xs">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <span>My Appointments</span>
      <span class="px-1.5 py-0.2 text-[10px] rounded-full bg-white/20 text-white font-bold"><%= todayBookings.length + upcomingBookings.length %></span>
    </button>

    <button type="button" onclick="switchStaffTab('schedule')" id="tab-nav-schedule"
      class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition flex items-center gap-2 cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span>My Schedule & Overrides</span>
      <% if (scheduleOverrides && scheduleOverrides.length > 0) { %>
        <span class="px-1.5 py-0.2 text-[10px] rounded-full bg-amber-100 text-amber-800 font-bold"><%= scheduleOverrides.length %></span>
      <% } %>
    </button>

    <button type="button" onclick="switchStaffTab('chat')" id="tab-nav-chat"
      class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition flex items-center gap-2 cursor-pointer">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      <span>Team Chat with Owner</span>
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    </button>

    <button type="button" onclick="switchStaffTab('profile')" id="tab-nav-profile"
      class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition flex items-center gap-2 cursor-pointer ml-auto">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      <span>My Profile & Security</span>
    </button>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       TAB 1: MY APPOINTMENTS
  ════════════════════════════════════════════════════════════ -->
  <div id="section-appointments" class="space-y-6">

    <!-- Sub filter tabs -->
    <div class="flex items-center gap-2 border-b border-gray-200 pb-3">
      <button type="button" onclick="filterAppointments('today')" id="sub-filter-today"
        class="px-4 py-1.5 rounded-lg text-xs font-bold bg-primary-100 text-primary-800 transition cursor-pointer">
        Today's Sessions (<%= todayBookings.length %>)
      </button>
      <button type="button" onclick="filterAppointments('upcoming')" id="sub-filter-upcoming"
        class="px-4 py-1.5 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-900 transition cursor-pointer">
        Upcoming Appointments (<%= upcomingBookings.length %>)
      </button>
      <button type="button" onclick="filterAppointments('past')" id="sub-filter-past"
        class="px-4 py-1.5 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-900 transition cursor-pointer">
        Past & Completed (<%= pastBookings.length %>)
      </button>
    </div>

    <!-- ── Today's Appointments List ── -->
    <div id="group-today" class="space-y-3">
      <% if (todayBookings.length === 0) { %>
        <div class="bg-white rounded-2xl p-10 text-center border border-gray-200 shadow-xs">
          <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          </div>
          <h3 class="text-sm font-bold text-gray-900">No Appointments Scheduled for Today</h3>
          <p class="text-xs text-gray-500 mt-1">Enjoy your day! Check upcoming appointments in the next tab.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% todayBookings.forEach(b => { %>
            <div class="bg-white rounded-2xl p-5 border border-primary-200 shadow-xs hover:shadow-md transition space-y-4">
              <div class="flex justify-between items-start">
                <div>
                  <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    Today &bull; <%= formatTimeRange12(b.startTime, b.endTime) %>
                  </span>
                  <h3 class="text-base font-bold text-gray-900 mt-2"><%= b.customerName %></h3>
                  <p class="text-xs text-gray-500 flex items-center gap-2 mt-0.5">
                    <span><%= b.service?.name %></span>
                    <span>&bull;</span>
                    <span class="font-medium text-primary-600">₹<%= b.totalPrice %></span>
                  </p>
                </div>
                <span class="px-2.5 py-1 text-[10px] font-bold rounded-lg uppercase tracking-wider
                  <%= b.status === 'COMPLETED' ? 'bg-gray-100 text-gray-700' : 'bg-primary-50 text-primary-700' %>">
                  <%= b.status %>
                </span>
              </div>

              <!-- Customer info -->
              <div class="text-xs text-gray-600 bg-gray-50 rounded-xl p-3 space-y-1">
                <p><strong>Email:</strong> <%= b.customerEmail %></p>
                <% if (b.customerPhone) { %>
                  <p><strong>Phone:</strong> <%= b.customerPhone %></p>
                <% } %>
                <% if (b.notes) { %>
                  <p class="text-gray-700 mt-1 italic">"<%= b.notes %>"</p>
                <% } %>
              </div>

              <!-- Actions -->
              <div class="flex items-center gap-2 pt-2 border-t border-gray-100">
                <button type="button" onclick="openStaffClientChat('<%= b.id %>', '<%= b.tenantId %>', '<%= escapeHtml(b.customerName) %>', '<%= escapeHtml(b.service?.name || '') %>')"
                  class="flex-1 py-2 px-3 bg-primary-50 hover:bg-primary-100 text-primary-700 text-xs font-semibold rounded-xl border border-primary-200 transition flex items-center justify-center gap-1.5 cursor-pointer">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                  <span>Chat with Client</span>
                </button>

                <% if (b.status !== 'COMPLETED') { %>
                  <form action="/staff/bookings/<%= b.id %>/status" method="POST" class="inline">
                    <input type="hidden" name="status" value="COMPLETED">
                    <button type="submit" class="py-2 px-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-xl transition cursor-pointer flex items-center gap-1">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                      <span>Mark Done</span>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- ── Upcoming Appointments List ── -->
    <div id="group-upcoming" class="hidden space-y-3">
      <% if (upcomingBookings.length === 0) { %>
        <div class="bg-white rounded-2xl p-10 text-center border border-gray-200 shadow-xs">
          <p class="text-sm font-semibold text-gray-700">No upcoming appointments scheduled.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% upcomingBookings.forEach(b => { %>
            <div class="bg-white rounded-2xl p-5 border border-gray-200 shadow-xs hover:shadow-md transition space-y-4">
              <div class="flex justify-between items-start">
                <div>
                  <span class="inline-flex items-center text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                    <%= formatDate12(b.startTime) %> &bull; <%= formatTimeRange12(b.startTime, b.endTime) %>
                  </span>
                  <h3 class="text-base font-bold text-gray-900 mt-2"><%= b.customerName %></h3>
                  <p class="text-xs text-gray-500 mt-0.5"><%= b.service?.name %> &bull; <span class="font-medium text-primary-600">₹<%= b.totalPrice %></span></p>
                </div>
                <span class="px-2.5 py-1 text-[10px] font-bold rounded-lg uppercase tracking-wider bg-primary-50 text-primary-700">
                  <%= b.status %>
                </span>
              </div>

              <div class="text-xs text-gray-600 bg-gray-50 rounded-xl p-3 space-y-1">
                <p><strong>Email:</strong> <%= b.customerEmail %></p>
                <% if (b.customerPhone) { %><p><strong>Phone:</strong> <%= b.customerPhone %></p><% } %>
              </div>

              <div class="flex items-center gap-2 pt-2 border-t border-gray-100">
                <button type="button" onclick="openStaffClientChat('<%= b.id %>', '<%= b.tenantId %>', '<%= escapeHtml(b.customerName) %>', '<%= escapeHtml(b.service?.name || '') %>')"
                  class="flex-1 py-2 px-3 bg-primary-50 hover:bg-primary-100 text-primary-700 text-xs font-semibold rounded-xl border border-primary-200 transition flex items-center justify-center gap-1.5 cursor-pointer">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                  <span>Chat with Client</span>
                </button>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- ── Past & Completed Appointments List ── -->
    <div id="group-past" class="hidden space-y-3">
      <% if (pastBookings.length === 0) { %>
        <div class="bg-white rounded-2xl p-10 text-center border border-gray-200 shadow-xs">
          <p class="text-sm font-semibold text-gray-700">No past appointments recorded.</p>
        </div>
      <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% pastBookings.forEach(b => { %>
            <div class="bg-gray-50 rounded-2xl p-4 border border-gray-200 text-xs space-y-2 opacity-85">
              <div class="flex justify-between items-center">
                <span class="font-bold text-gray-900"><%= b.customerName %></span>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= b.status === 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-200 text-gray-600' %>">
                  <%= b.status %>
                </span>
              </div>
              <p class="text-gray-500"><%= b.service?.name %> &bull; <%= formatDate12(b.startTime) %> at <%= formatTimeRange12(b.startTime, b.endTime) %></p>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════
       TAB 2: MY SCHEDULE & OVERRIDES
  ════════════════════════════════════════════════════════════ -->
  <div id="section-schedule" class="hidden space-y-6">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Standard Weekly Business Hours (lg:col-span-5) -->
      <div class="lg:col-span-5 bg-white rounded-2xl p-6 border border-gray-200 shadow-xs">
        <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
          <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Standard Weekly Hours
        </h3>
        <p class="text-xs text-gray-500 mt-1 mb-4">Base working hours set by <%= tenant.name %>.</p>

        <div class="space-y-2">
          <% 
            const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            for (let i = 0; i < 7; i++) {
              const bh = businessHours.find(h => h.dayOfWeek === i);
          %>
            <div class="flex items-center justify-between text-xs py-2 px-3 rounded-lg <%= (bh && !bh.isClosed) ? 'bg-gray-50' : 'bg-gray-100 text-gray-400' %>">
              <span class="font-semibold"><%= dayNames[i] %></span>
              <span>
                <% if (bh && !bh.isClosed) { %>
                  <%= formatTime12(bh.openTime) %> - <%= formatTime12(bh.closeTime) %>
                <% } else { %>
                  <span class="font-medium text-gray-400">Closed</span>
                <% } %>
              </span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Schedule Overrides & Time-Off Form (lg:col-span-7) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Add Override Card -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-xs">
          <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Request Day Off or Custom Hours
          </h3>
          <p class="text-xs text-gray-500 mt-1 mb-4">Set temporary availability overrides for specific dates.</p>

          <form action="/staff/schedule/override" method="POST" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Select Date</label>
                <input type="date" name="date" required min="<%= new Date().toISOString().split('T')[0] %>"
                  class="w-full text-xs px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary-500">
              </div>

              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Status on this Date</label>
                <select name="isOff" id="override-is-off" onchange="toggleCustomTimes(this.value)"
                  class="w-full text-xs px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary-500">
                  <option value="true">Mark Day Off / Leave</option>
                  <option value="false">Custom Working Hours</option>
                </select>
              </div>
            </div>

            <div id="custom-time-inputs" class="grid grid-cols-2 gap-4 hidden">
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">Start Time</label>
                <input type="time" name="startTime" value="10:00"
                  class="w-full text-xs px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary-500">
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-700 mb-1">End Time</label>
                <input type="time" name="endTime" value="18:00"
                  class="w-full text-xs px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary-500">
              </div>
            </div>

            <div class="flex justify-end pt-2">
              <button type="submit" class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold rounded-xl shadow-xs transition cursor-pointer">
                Save Schedule Override
              </button>
            </div>
          </form>
        </div>

        <!-- Active Overrides List -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-xs">
          <h3 class="text-sm font-bold text-gray-900 mb-3">Active Custom Overrides</h3>
          <% if (!scheduleOverrides || scheduleOverrides.length === 0) { %>
            <p class="text-xs text-gray-500">No upcoming overrides active. You are following standard working hours.</p>
          <% } else { %>
            <div class="space-y-2">
              <% scheduleOverrides.forEach(ov => { %>
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl border border-gray-200 text-xs">
                  <div>
                    <span class="font-bold text-gray-900"><%= formatDate12(ov.date) %></span>
                    <span class="ml-2 px-2 py-0.5 rounded text-[10px] font-bold <%= ov.isOff ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-800' %>">
                      <%= ov.isOff ? 'Day Off / Leave' : (formatTime12(ov.startTime) + ' - ' + formatTime12(ov.endTime)) %>
                    </span>
                  </div>
                  <form action="/staff/schedule/override/delete" method="POST" class="inline">
                    <input type="hidden" name="date" value="<%= ov.date.toISOString().split('T')[0] %>">
                    <button type="submit" class="text-red-600 hover:text-red-800 text-xs font-semibold cursor-pointer">Remove</button>
                  </form>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>

      </div>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════════════
       TAB 3: TEAM CHAT WITH OWNER
  ════════════════════════════════════════════════════════════ -->
  <div id="section-chat" class="hidden">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden flex flex-col h-[640px]">
      
      <!-- Chat Header -->
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-primary-600 text-white font-bold text-sm flex items-center justify-center">
            <%= (tenant.name.charAt(0) || 'O').toUpperCase() %>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 text-sm"><%= tenant.name %> (Owner)</h3>
            <p class="text-xs text-gray-500">Direct internal communication with business owner</p>
          </div>
        </div>
        <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          Live Connected
        </span>
      </div>

      <!-- Messages Stream -->
      <div id="owner-chat-messages" class="flex-1 overflow-y-auto p-6 space-y-3 bg-gray-50/50">
        <div class="text-center py-12 text-gray-400 text-xs">Loading team messages...</div>
      </div>

      <!-- Input composer -->
      <form id="owner-chat-form" class="p-4 bg-white border-t border-gray-200 flex items-end gap-2.5">
        <textarea id="owner-chat-input" rows="1" placeholder="Type your message to the business owner... (Press Enter to send)"
          class="flex-1 px-4 py-2.5 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500 resize-none transition leading-relaxed"></textarea>
        <button type="submit" id="owner-chat-send-btn"
          class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded-xl shadow-xs transition flex items-center gap-1.5 cursor-pointer disabled:opacity-50">
          <span>Send</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        </button>
      </form>

    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       TAB 4: MY PROFILE & SECURITY
  ════════════════════════════════════════════════════════════ -->
  <div id="section-profile" class="hidden space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      
      <!-- Profile Information -->
      <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-xs space-y-4">
        <h3 class="text-base font-bold text-gray-900">Specialist Profile</h3>
        <div class="space-y-3 text-xs">
          <div>
            <label class="block text-gray-500 font-semibold mb-0.5">Full Name</label>
            <p class="font-bold text-gray-900 text-sm"><%= staff.name %></p>
          </div>
          <div>
            <label class="block text-gray-500 font-semibold mb-0.5">Specialization / Role</label>
            <p class="font-bold text-gray-900"><%= staff.roleTitle || 'Specialist' %></p>
          </div>
          <div>
            <label class="block text-gray-500 font-semibold mb-0.5">Portal Email (Login Account)</label>
            <p class="font-medium text-gray-900"><%= staff.email || user.email %></p>
          </div>
          <div>
            <label class="block text-gray-500 font-semibold mb-0.5">Phone Number</label>
            <p class="font-medium text-gray-900"><%= staff.phone || 'Not provided' %></p>
          </div>
          <% if (staff.bio) { %>
            <div>
              <label class="block text-gray-500 font-semibold mb-0.5">Specialist Bio</label>
              <p class="text-gray-700 bg-gray-50 p-3 rounded-lg"><%= staff.bio %></p>
            </div>
          <% } %>
          <div>
            <label class="block text-gray-500 font-semibold mb-1">Services Qualified to Provide</label>
            <div class="flex flex-wrap gap-1.5">
              <% if (staff.staffServices && staff.staffServices.length > 0) { %>
                <% staff.staffServices.forEach(ss => { %>
                  <span class="px-2.5 py-1 rounded-lg text-xs bg-primary-50 text-primary-700 font-semibold border border-primary-100">
                    <%= ss.service?.name %>
                  </span>
                <% }); %>
              <% } else { %>
                <span class="text-gray-400">All general salon services</span>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Password Change Card -->
      <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-xs space-y-4">
        <h3 class="text-base font-bold text-gray-900">Update Security Password</h3>
        <p class="text-xs text-gray-500">If you received a temporary password from your owner, change it here for security.</p>

        <form id="staff-change-password-form" class="space-y-3">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">Current Password</label>
            <input type="password" id="staff-cur-pass" required placeholder="Enter current / temporary password"
              class="w-full text-xs px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">New Password (Min 8 chars, 1 uppercase, 1 number, 1 special)</label>
            <input type="password" id="staff-new-pass" required placeholder="e.g. MySecret@2026"
              class="w-full text-xs px-3 py-2 border border-gray-200 rounded-lg focus:outline-none focus:ring-1 focus:ring-primary-500">
          </div>
          <div id="staff-pass-alert" class="hidden text-xs p-2.5 rounded-lg"></div>
          <button type="submit" id="staff-pass-btn"
            class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold rounded-xl shadow-xs transition cursor-pointer">
            Update Password
          </button>
        </form>
      </div>

    </div>
  </div>

</div>

<!-- ═══════════════════════════════════════════════════════════
     Direct Client Consultation Modal for Staff
════════════════════════════════════════════════════════════ -->
<div id="staff-client-chat-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 hidden" style="display: none;">
  <div class="bg-white rounded-2xl shadow-2xl border border-gray-200 w-full max-w-lg overflow-hidden flex flex-col h-[560px] animate-fade-in" onclick="event.stopPropagation()">
    
    <!-- Modal Header -->
    <div class="px-5 py-3.5 bg-gray-50 border-b border-gray-200 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div id="client-modal-avatar" class="w-9 h-9 rounded-full bg-primary-100 text-primary-700 font-bold text-xs flex items-center justify-center">?</div>
        <div>
          <h3 id="client-modal-title" class="font-bold text-gray-900 text-sm">Customer Consultation</h3>
          <p id="client-modal-service" class="text-xs text-gray-500">Service consultation</p>
        </div>
      </div>
      <button type="button" onclick="closeStaffClientChat()" class="text-gray-400 hover:text-gray-600 text-xl font-bold p-1 cursor-pointer">&times;</button>
    </div>

    <!-- Modal Stream -->
    <div id="client-modal-messages" class="flex-1 overflow-y-auto p-4 space-y-2.5 bg-gray-50/50">
      <div class="text-center py-10 text-gray-400 text-xs">Loading consultation history...</div>
    </div>

    <!-- Modal Reply Composer -->
    <form id="client-modal-form" class="p-3 bg-white border-t border-gray-200 flex gap-2">
      <input type="text" id="client-modal-input" placeholder="Reply to customer..." autocomplete="off"
        class="flex-1 px-3.5 py-2 text-xs bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:outline-none focus:ring-1 focus:ring-primary-500">
      <button type="submit" id="client-modal-send-btn"
        class="px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-xs font-semibold rounded-xl transition cursor-pointer flex items-center gap-1">
        <span>Send</span>
      </button>
    </form>

  </div>
</div>

<script src="https://cdn.socket.io/4.6.2/socket.io.min.js"></script>
<script>
(function() {
  var tenantId = "<%= tenant.id %>";
  var staffId = "<%= staff.id %>";
  var staffName = "<%= staff.name %>";
  var staffEmail = "<%= staff.email || user.email %>";
  var ownerThreadId = "staff_" + staffId;
  var socket = null;
  var activeClientBookingId = null;

  // Tab switcher
  window.switchStaffTab = function(tab) {
    var tabs = ['appointments', 'schedule', 'chat', 'profile'];
    tabs.forEach(function(t) {
      var nav = document.getElementById('tab-nav-' + t);
      var sec = document.getElementById('section-' + t);
      if (t === tab) {
        nav.className = 'px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 cursor-pointer bg-primary-600 text-white shadow-xs';
        sec.classList.remove('hidden');
      } else {
        nav.className = 'px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition flex items-center gap-2 cursor-pointer';
        sec.classList.add('hidden');
      }
    });

    if (tab === 'chat') {
      loadOwnerChat();
    }
  };

  // Sub filter switcher
  window.filterAppointments = function(type) {
    var groups = ['today', 'upcoming', 'past'];
    groups.forEach(function(g) {
      var grp = document.getElementById('group-' + g);
      var btn = document.getElementById('sub-filter-' + g);
      if (g === type) {
        grp.classList.remove('hidden');
        btn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold bg-primary-100 text-primary-800 transition cursor-pointer';
      } else {
        grp.classList.add('hidden');
        btn.className = 'px-4 py-1.5 rounded-lg text-xs font-medium text-gray-500 hover:text-gray-900 transition cursor-pointer';
      }
    });
  };

  window.toggleCustomTimes = function(val) {
    var timeInputs = document.getElementById('custom-time-inputs');
    if (val === 'false') {
      timeInputs.classList.remove('hidden');
    } else {
      timeInputs.classList.add('hidden');
    }
  };

  function escapeHtml(str) {
    if (!str) return '';
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // ── Owner Team Chat Logic ────────────────────────────────────
  var ownerChatContainer = document.getElementById('owner-chat-messages');
  var ownerChatForm = document.getElementById('owner-chat-form');
  var ownerChatInput = document.getElementById('owner-chat-input');
  var ownerChatSendBtn = document.getElementById('owner-chat-send-btn');

  async function loadOwnerChat() {
    try {
      var res = await fetch('/api/v1/chat/messages?threadId=' + encodeURIComponent(ownerThreadId) + '&tenantId=' + encodeURIComponent(tenantId));
      if (!res.ok) throw new Error('Failed to load messages');
      var data = await res.json();
      renderOwnerMessages(data.messages || []);
    } catch(err) {
      ownerChatContainer.innerHTML = '<div class="text-center py-10 text-red-500 text-xs">Error loading team chat: ' + err.message + '</div>';
    }
  }

  function renderOwnerMessages(messages) {
    if (!messages || messages.length === 0) {
      ownerChatContainer.innerHTML = '<div class="text-center py-16 text-gray-400 text-xs">' +
        '<p class="font-bold text-gray-600 text-sm">No messages yet with the Salon Owner</p>' +
        '<p class="text-gray-400 mt-1">Send a message below to ask questions about your schedule or clients.</p>' +
        '</div>';
      return;
    }

    var html = '';
    messages.forEach(function(m) {
      var isMe = (m.senderType === 'STAFF');
      html += '<div class="flex ' + (isMe ? 'justify-end' : 'justify-start') + ' mb-2">';
      html += '<div class="max-w-[78%] rounded-2xl px-4 py-2.5 text-xs shadow-2xs ' +
        (isMe ? 'bg-primary-600 text-white rounded-br-xs' : 'bg-white text-gray-900 border border-gray-200 rounded-bl-xs') + '">';
      html += '<p class="font-bold text-[10px] mb-0.5 ' + (isMe ? 'text-primary-100' : 'text-gray-500') + '">' +
        escapeHtml(m.senderName || (isMe ? 'You' : 'Owner')) + '</p>';
      html += '<p class="whitespace-pre-wrap leading-relaxed">' + escapeHtml(m.message) + '</p>';
      html += '<p class="text-[9px] mt-1 text-right ' + (isMe ? 'text-primary-200' : 'text-gray-400') + '">' +
        (m.createdAt ? new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '') + '</p>';
      html += '</div></div>';
    });

    ownerChatContainer.innerHTML = html;
    ownerChatContainer.scrollTop = ownerChatContainer.scrollHeight;
  }

  ownerChatForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    var text = ownerChatInput.value.trim();
    if (!text) return;

    ownerChatSendBtn.disabled = true;
    ownerChatInput.value = '';

    try {
      var res = await fetch('/api/v1/chat/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tenantId: tenantId,
          threadId: ownerThreadId,
          staffId: staffId,
          senderType: 'STAFF',
          senderName: staffName,
          senderEmail: staffEmail,
          message: text,
        })
      });
      if (!res.ok) throw new Error('Failed to send message');
      loadOwnerChat();
    } catch(err) {
      alert('Error sending: ' + err.message);
    } finally {
      ownerChatSendBtn.disabled = false;
      ownerChatInput.focus();
    }
  });

  // ── Client Consultation Chat Modal ────────────────────────────
  var clientModal = document.getElementById('staff-client-chat-modal');
  var clientModalAvatar = document.getElementById('client-modal-avatar');
  var clientModalTitle = document.getElementById('client-modal-title');
  var clientModalService = document.getElementById('client-modal-service');
  var clientModalMessages = document.getElementById('client-modal-messages');
  var clientModalForm = document.getElementById('client-modal-form');
  var clientModalInput = document.getElementById('client-modal-input');
  var clientModalSendBtn = document.getElementById('client-modal-send-btn');

  window.openStaffClientChat = function(bookingId, bTenantId, cName, sName) {
    activeClientBookingId = bookingId;
    clientModalAvatar.textContent = (cName.charAt(0) || 'C').toUpperCase();
    clientModalTitle.textContent = cName + ' (Client Consultation)';
    clientModalService.textContent = sName || 'Appointment Consultation';
    clientModal.style.display = 'flex';
    clientModal.classList.remove('hidden');

    loadClientMessages(bookingId);
    if (socket) {
      socket.emit('join:thread', 'booking_' + bookingId);
    }
    setTimeout(function(){ clientModalInput.focus(); }, 100);
  };

  window.closeStaffClientChat = function() {
    clientModal.style.display = 'none';
    clientModal.classList.add('hidden');
    activeClientBookingId = null;
  };

  async function loadClientMessages(bookingId) {
    try {
      var res = await fetch('/api/v1/chat/messages?threadId=booking_' + encodeURIComponent(bookingId) + '&tenantId=' + encodeURIComponent(tenantId));
      if (!res.ok) throw new Error('Failed to load consultation');
      var data = await res.json();
      renderClientMessages(data.messages || []);
    } catch(err) {
      clientModalMessages.innerHTML = '<div class="text-center py-10 text-red-500 text-xs">Error: ' + err.message + '</div>';
    }
  }

  function renderClientMessages(messages) {
    if (!messages || messages.length === 0) {
      clientModalMessages.innerHTML = '<div class="text-center py-12 text-gray-400 text-xs">' +
        '<p class="font-bold text-gray-700">No consultation messages yet</p>' +
        '<p class="text-gray-400 mt-1">Send a message to your customer regarding prep, timing or preferences.</p>' +
        '</div>';
      return;
    }

    var html = '';
    messages.forEach(function(m) {
      var isStaff = (m.senderType === 'STAFF' || m.senderType === 'OWNER');
      html += '<div class="flex ' + (isStaff ? 'justify-end' : 'justify-start') + ' mb-2">';
      html += '<div class="max-w-[80%] rounded-2xl px-3.5 py-2 text-xs shadow-2xs ' +
        (isStaff ? 'bg-primary-600 text-white rounded-br-xs' : 'bg-white text-gray-900 border border-gray-200 rounded-bl-xs') + '">';
      html += '<p class="font-bold text-[10px] mb-0.5 ' + (isStaff ? 'text-primary-100' : 'text-gray-500') + '">' +
        escapeHtml(m.senderName) + '</p>';
      html += '<p class="whitespace-pre-wrap leading-relaxed">' + escapeHtml(m.message) + '</p>';
      html += '</div></div>';
    });

    clientModalMessages.innerHTML = html;
    clientModalMessages.scrollTop = clientModalMessages.scrollHeight;
  }

  clientModalForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    if (!activeClientBookingId) return;
    var text = clientModalInput.value.trim();
    if (!text) return;

    clientModalSendBtn.disabled = true;
    clientModalInput.value = '';

    try {
      var res = await fetch('/api/v1/chat/messages', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tenantId: tenantId,
          bookingId: activeClientBookingId,
          threadId: 'booking_' + activeClientBookingId,
          senderType: 'STAFF',
          senderName: staffName,
          senderEmail: staffEmail,
          message: text,
        })
      });
      if (!res.ok) throw new Error('Failed to send');
      loadClientMessages(activeClientBookingId);
    } catch(err) {
      alert('Error: ' + err.message);
    } finally {
      clientModalSendBtn.disabled = false;
      clientModalInput.focus();
    }
  });

  // Password change handler
  var passForm = document.getElementById('staff-change-password-form');
  var passAlert = document.getElementById('staff-pass-alert');
  passForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    var cur = document.getElementById('staff-cur-pass').value;
    var nw = document.getElementById('staff-new-pass').value;

    passAlert.className = 'hidden';

    try {
      var res = await fetch('/api/v1/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword: cur, newPassword: nw })
      });
      var d = await res.json();
      if (!res.ok) throw new Error(d.message || d.error || 'Failed to update password');

      passAlert.className = 'text-xs p-3 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 block';
      passAlert.textContent = 'Password updated successfully!';
      passForm.reset();
    } catch(err) {
      passAlert.className = 'text-xs p-3 rounded-lg bg-red-50 text-red-800 border border-red-200 block';
      passAlert.textContent = err.message;
    }
  });

  // Socket setup
  try {
    socket = io();
    socket.emit('join:thread', ownerThreadId);
    socket.on('chat:message', function(m) {
      if (m.threadId === ownerThreadId) {
        loadOwnerChat();
      }
      if (activeClientBookingId && m.threadId === ('booking_' + activeClientBookingId)) {
        loadClientMessages(activeClientBookingId);
      }
    });
  } catch(e){}

  // Initial tab
  var initialTab = "<%= activeTab || 'appointments' %>";
  switchStaffTab(initialTab);

})();
</script>
